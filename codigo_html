function validarFormulario() { 
  let isValid = true;
  let primeiroErro = null;
  
  // Lista de campos obrigatórios
  const requiredFields = [
    'loja', 'segmento', 'telefone', 'trafego', 
    'quantidade_lojas', 'adesao', 'forma_pagamento', 
    'parcelas', 'plano_assinatura', 'usuario'
  ];

  // Limpar mensagens de erro anteriores
  requiredFields.forEach(field => {
    const element = document.getElementById(field);
    const errorElement = document.getElementById(`erro-${field}`);
    if (element && errorElement) {
      element.classList.remove('error');
      errorElement.style.display = 'none';
    }
  });

  // ✅ VALIDAÇÃO CORRIGIDA DA ADESÃO
  const adesaoElement = document.getElementById('adesao');
  const adesao = adesaoElement ? parseInt(adesaoElement.value) : 0;
  const dataPagamentoAdesao = document.getElementById('data_pagamento_adesao');
  const formaPagamento = document.getElementById('forma_pagamento');
  const parcelas = document.getElementById('parcelas');
  
  console.log("💰 Validando adesão - Valor:", adesao);
  
  if (adesao > 0) {
    // ✅ ADESÃO > R$ 0,00 - VALIDAR CAMPOS DE PAGAMENTO

    if (!formaPagamento.value || formaPagamento.value === 'ISENTO') {
      formaPagamento.classList.add('error');
      document.getElementById('erro-forma_pagamento').style.display = 'block';
      isValid = false;
      if (!primeiroErro) primeiroErro = formaPagamento;
      console.log("❌ Forma pagamento obrigatória para adesão > 0");
    }
    
    if (!parcelas.value || parcelas.value === 'ISENTO') {
      parcelas.classList.add('error');
      document.getElementById('erro-parcelas').style.display = 'block';
      isValid = false;
      if (!primeiroErro) primeiroErro = parcelas;
      console.log("❌ Parcelas obrigatórias para adesão > 0");
    }
  } else {
    // ✅ ADESÃO = R$ 0,00 - REMOVER ERROS DOS CAMPOS DE PAGAMENTO
    if (dataPagamentoAdesao) {
      dataPagamentoAdesao.classList.remove('error');
      document.getElementById('erro-data_pagamento_adesao').style.display = 'none';
    }
    if (formaPagamento) {
      formaPagamento.classList.remove('error');
      document.getElementById('erro-forma_pagamento').style.display = 'none';
    }
    if (parcelas) {
      parcelas.classList.remove('error');
      document.getElementById('erro-parcelas').style.display = 'none';
    }
    console.log("✅ Adesão = 0 - Campos de pagamento não obrigatórios");
  }

  // Validar cada campo obrigatório
  requiredFields.forEach(field => {
    const element = document.getElementById(field);
    const errorElement = document.getElementById(`erro-${field}`);
    
    if (element && errorElement) {
      const value = element.value ? element.value.toString().trim() : '';
      
      if (!value) {
        element.classList.add('error');
        errorElement.style.display = 'block';
        isValid = false;
        
        // 🔥 CORREÇÃO: SALVAR O PRIMEIRO ERRO PARA SCROLL
        if (!primeiroErro) {
          primeiroErro = element;
        }
      }
    }
  });

  // Validar fornecedor (campo especial)
  const fornecedorCheckboxes = document.querySelectorAll('#fornecedor-container input:checked');
  const fornecedorError = document.getElementById('erro-fornecedor');
  if (fornecedorCheckboxes.length === 0) {
    document.getElementById('fornecedor-container').style.border = '2px solid var(--danger)';
    document.getElementById('fornecedor-container').style.borderRadius = '10px';
    document.getElementById('fornecedor-container').style.padding = '10px';
    fornecedorError.style.display = 'block';
    isValid = false;
    
    // 🔥 CORREÇÃO: ADICIONAR FORNECEDOR COMO PRIMEIRO ERRO SE FOR O CASO
    if (!primeiroErro) {
      primeiroErro = document.getElementById('fornecedor-container');
    }
    console.log("❌ Nenhum fornecedor selecionado");
  } else {
    document.getElementById('fornecedor-container').style.border = '';
    document.getElementById('fornecedor-container').style.padding = '';
    fornecedorError.style.display = 'none';
    console.log("✅ Fornecedores selecionados:", fornecedorCheckboxes.length);
  }

  // Validar seção de atualização (se visível)
  if (document.getElementById('secaoAtualizacao').style.display !== 'none') {
    const updateFields = ['status', 'evento', 'observacao'];
    updateFields.forEach(field => {
      const element = document.getElementById(field);
      const errorElement = document.getElementById(`erro-${field}`);
      
      if (element && errorElement) {
        const value = element.value ? element.value.toString().trim() : '';
        
        if (!value) {
          element.classList.add('error');
          errorElement.style.display = 'block';
          isValid = false;
          
          // 🔥 CORREÇÃO: SALVAR O PRIMEIRO ERRO PARA SCROLL
          if (!primeiroErro) {
            primeiroErro = element;
          }
          console.log(`❌ Campo de atualização obrigatório: ${field}`);
        }
      }
    });
  }

  // 🔥 CORREÇÃO: FAZER SCROLL PARA O PRIMEIRO CAMPO COM ERRO
  if (!isValid && primeiroErro) {
    console.log("🎯 Fazendo scroll para o primeiro erro:", primeiroErro.id);
    
    // Scroll suave para o campo com erro
    primeiroErro.scrollIntoView({ 
      behavior: 'smooth', 
      block: 'center' 
    });
    
    // Focar no campo com erro
    if (primeiroErro.tagName === 'INPUT' || primeiroErro.tagName === 'SELECT' || primeiroErro.tagName === 'TEXTAREA') {
      setTimeout(() => {
        primeiroErro.focus();
      }, 500);
    }
    
    showMessage('error', '⚠️ Preencha todos os campos obrigatórios!');
    return false;
  }

  if (!isValid) {
    showMessage('error', '⚠️ Preencha todos os campos obrigatórios!');
    console.log("❌ Validação do formulário falhou");
    return false;
  }

  console.log("✅ Validação do formulário passou!");
  return true;
}

