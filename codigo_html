// 🔥 FUNÇÃO CORRIGIDA: CALCULAR DEFASAGEM CONSISTENTE
function calcularDefasagemIgualCards(dataRetorno, dataUltimoEvento, status) {
    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0);
    
    console.log("🔍 CALCULANDO DEFASAGEM UNIFICADA:");
    console.log("Status recebido:", status);
    console.log("Data Retorno Recebida:", dataRetorno);
    console.log("Data Último Evento Recebida:", dataUltimoEvento);
    
    // ⭐⭐ CORREÇÃO: VERIFICA TODAS AS VARIAÇÕES POSSÍVEIS DO STATUS ⭐⭐
    const statusNormalizado = String(status).toUpperCase().trim();
    
    if (statusNormalizado === "CONCLUIDO" || 
        statusNormalizado === "CONCLUÍDO" ||
        statusNormalizado === "NAO CONCLUIDO" || 
        statusNormalizado === "NÃO CONCLUÍDO" ||
        statusNormalizado === "NAO CONCLUÍDO" ||
        statusNormalizado === "NÃO CONCLUIDO") {
        
        console.log("✅ Status encerrado - Defasagem zerada");
        return { dias: 0, tipo: 'encerrado' };
    }
    
    // PRIORIDADE PARA DATA RETORNO
    if (dataRetorno && dataRetorno !== 'N/A' && dataRetorno !== '') {
        try {
            const partes = dataRetorno.split('/');
            const dataRetornoObj = new Date(partes[2], partes[1] - 1, partes[0]);
            dataRetornoObj.setHours(0, 0, 0, 0);
            
            console.log("📅 Calculando por DATA RETORNO:", dataRetornoObj.toLocaleDateString('pt-BR'));
            
            const diffMs = hoje - dataRetornoObj;
            const dias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
            
            console.log("📊 Dias calculados (data retorno):", dias);
            
            return { dias: dias, tipo: 'data_retorno' };
        } catch (e) {
            console.log("❌ Erro ao calcular data retorno:", e);
        }
    }
    
    // FALLBACK: DATA ÚLTIMO EVENTO
    if (dataUltimoEvento && dataUltimoEvento !== 'N/A' && dataUltimoEvento !== '') {
        try {
            const partes = dataUltimoEvento.split('/');
            const dataEventoObj = new Date(partes[2], partes[1] - 1, partes[0]);
            dataEventoObj.setHours(0, 0, 0, 0);
            
            console.log("🕒 Calculando por ÚLTIMO EVENTO:", dataEventoObj.toLocaleDateString('pt-BR'));
            
            const diffMs = hoje - dataEventoObj;
            const dias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
            
            console.log("📊 Dias calculados (último evento):", dias);
            
            return { dias: dias, tipo: 'ultimo_evento' };
        } catch (e) {
            console.log("❌ Erro ao calcular último evento:", e);
        }
    }
    
    console.log("📝 Nenhuma data válida para cálculo");
    return { dias: 0, tipo: 'sem_data' };
}

function normalizarNoFrontend(texto) {
    if (!texto || typeof texto !== 'string') return texto;
    
    if (!isNaN(texto)) return texto;
    if (texto.includes('R$')) return texto;
    if (texto.match(/\d{2}\/\d{2}\/\d{4}/)) return texto;
    
    return texto
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toUpperCase()
        .trim();
}




// 🔥 FUNÇÃO AUXILIAR: NORMALIZAR NO FRONTEND
function normalizarNoFrontend(texto) {
    if (!texto || typeof texto !== 'string') return texto;
    
    // 🔥 NÃO normalizar se for número, data, ou campo monetário
