  </div>

  <script>
    // Variáveis globais
    let lojaExiste = false;
    let registroId = null;
    let todasLojas = [];

    // Quando a página carrega
    document.addEventListener("DOMContentLoaded", function() {
      console.log("🚀 Página carregada!");
      carregarLojasParaAutocomplete();
      inicializarMultiSelect();
    });

    // ⭐⭐ NOVA FUNÇÃO: MOSTRAR TODAS AS LOJAS (APENAS > 2 DIAS) ⭐⭐
    function mostrarTodasLojas() {
      console.log("🏪 Buscando lojas com defasagem > 2 dias...");
      
      const btnVerLojas = document.getElementById('btnVerLojas');
      btnVerLojas.innerHTML = '<div class="loading"><div class="spinner"></div> Carregando...</div>';
      btnVerLojas.disabled = true;

      google.script.run
        .withSuccessHandler(function(lojasComDados) {
          btnVerLojas.innerHTML = '<i class="fas fa-store"></i> Ver Lojas';
          btnVerLojas.disabled = false;
          
          if (lojasComDados && lojasComDados.length > 0) {
            exibirLojas(lojasComDados);
            
            // Scroll para a seção de lojas
            document.getElementById('secaoLojas').scrollIntoView({ 
              behavior: 'smooth', 
              block: 'start' 
            });
            
            showMessage('success', `✅ ${lojasComDados.length} lojas com defasagem > 2 dias carregadas!`);
          } else {
            showMessage('info', '🎉 Nenhuma loja com defasagem maior que 2 dias encontrada!');
            document.getElementById('secaoLojas').style.display = 'none';
          }
        })
        .withFailureHandler(function(error) {
          btnVerLojas.innerHTML = '<i class="fas fa-store"></i> Ver Lojas';
          btnVerLojas.disabled = false;
          showMessage('error', '❌ Erro ao carregar lojas: ' + error.message);
        })
        .buscarTodasLojasComDados();
    }

    // ⭐⭐ NOVA FUNÇÃO: EXIBIR LOJAS EM GRID ⭐⭐
    function exibirLojas(lojas) {
      const gridLojas = document.getElementById('gridLojas');
      const secaoLojas = document.getElementById('secaoLojas');
      
      // Ordenar lojas por defasagem (maior para menor)
      lojas.sort((a, b) => {
        const defasagemA = parseInt(a.defasagem) || 0;
        const defasagemB = parseInt(b.defasagem) || 0;
        return defasagemB - defasagemA;
      });
      
      gridLojas.innerHTML = '';
      
      lojas.forEach(loja => {
        const card = criarCardLoja(loja);
        gridLojas.appendChild(card);
      });
      
      secaoLojas.style.display = 'block';
    }

    // ⭐⭐ NOVA FUNÇÃO: CRIAR CARD DA LOJA ⭐⭐
    function criarCardLoja(loja) {
      const card = document.createElement('div');
      
      // Determinar classe CSS baseada no status
      let statusClass = '';
      let statusText = '';
      
      switch(loja.status) {
        case 'Em andamento':
          statusClass = 'em-andamento';
          statusText = 'Em Andamento';
          break;
        case 'Concluído':
          statusClass = 'concluido';
          statusText = 'Concluído';
          break;
        case 'Não Concluído':
          statusClass = 'nao-concluido';
          statusText = 'Não Concluído';
          break;
        default:
          statusClass = 'em-andamento';
          statusText = loja.status || 'Em Andamento';
      }
      
      card.className = `loja-card ${statusClass}`;
      
      // Extrair apenas o número da defasagem (remover "dias")
      const defasagemNumero = loja.defasagem ? loja.defasagem.toString().replace(' dias', '').replace(' dia', '') : '0';
      
      card.innerHTML = `
        <div class="loja-header">
          <div style="flex: 1;">
            <div class="loja-nome">${loja.loja || 'N/A'}</div>
            <div class="loja-info">
              <strong>Representante:</strong> ${loja.representante || 'N/A'}
            </div>
          </div>
          <span class="loja-status status-${statusClass.replace('-', '-')}">${statusText}</span>
        </div>
        
        <div class="loja-info">
          <strong>Defasagem:</strong> 
          <span class="loja-defasagem">
            <i class="fas fa-clock"></i>
            ${defasagemNumero} dias
          </span>
        </div>
        
        ${loja.data_retorno_cliente && loja.data_retorno_cliente !== 'N/A' ? `
        <div class="loja-info">
          <strong>Data retorno:</strong> 
          <span class="data-retorno-info">
            <i class="fas fa-calendar"></i>
            ${loja.data_retorno_cliente}
          </span>
        </div>
        ` : ''}
        
        <div class="loja-info">
          <strong>Último Evento:</strong> ${loja.evento || 'N/A'}
        </div>
        
        <div class="loja-info">
          <strong>Usuário:</strong> ${loja.usuario || 'N/A'}
        </div>
        
        <div class="loja-ultimo-evento">
          <i class="fas fa-calendar"></i>
          Último acionamento: ${loja.data_ultimo_evento || 'N/A'}
        </div>
      `;
      
      // Adicionar clique para carregar dados da loja
      card.style.cursor = 'pointer';
      card.addEventListener('click', function() {
        document.getElementById('loja').value = loja.loja;
        buscarLoja();
        
        // Scroll para o topo
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      
      return card;
    }

    // ⭐⭐ CARREGAR LOJAS DO GOOGLE SHEETS ⭐⭐
    function carregarLojasParaAutocomplete() {
      console.log("📋 Carregando lojas para autocomplete...");
      
      google.script.run
        .withSuccessHandler(function(lojas) {
          console.log("✅ Lojas recebidas:", lojas);
          todasLojas = lojas || [];
          
          if (todasLojas.length > 0) {
            console.log("🎯 " + todasLojas.length + " lojas carregadas automaticamente");
          } else {
            console.log("📝 Nenhuma loja encontrada na planilha");
          }
        })
        .withFailureHandler(function(error) {
          console.error("❌ Erro ao carregar lojas:", error);
        })
        .buscarTodasLojas();
    }

    // ⭐⭐ FILTRAR LOJAS DINAMICAMENTE ⭐⭐
    function filtrarLojas(valorDigitado) {
      const suggestions = document.getElementById('suggestions');
      
      console.log("🔍 Digitando:", valorDigitado);
      console.log("📋 Total de lojas:", todasLojas.length);
      
      if (!valorDigitado || valorDigitado.length < 1) {
        suggestions.style.display = 'none';
        return;
      }
      
      const valor = valorDigitado.toLowerCase();
      const lojasFiltradas = todasLojas.filter(loja => 
        loja && loja.toLowerCase().includes(valor)
      );
      
      console.log("🎯 Lojas filtradas:", lojasFiltradas);
      
      if (lojasFiltradas.length === 0) {
        suggestions.style.display = 'none';
        return;
      }
      
      // Mostrar sugestões
      suggestions.innerHTML = '';
      suggestions.style.display = 'block';
      
      lojasFiltradas.forEach(loja => {
        const div = document.createElement('div');
        div.className = 'suggestion-item';
        div.textContent = loja;
        div.onclick = function() {
          document.getElementById('loja').value = loja;
          suggestions.style.display = 'none';
          buscarLoja(); // Busca automaticamente os dados da loja
        };
        suggestions.appendChild(div);
      });
    }

    // ⭐⭐ BUSCAR LOJA AUTOMATICAMENTE ⭐⭐
    function buscarLoja() {
      const nomeLoja = document.getElementById('loja').value.trim();
      
      if (!nomeLoja) {
        return;
      }
      
      console.log("🔍 Buscando:", nomeLoja);
      
      google.script.run
        .withSuccessHandler(function(dados) {
          preencherDadosLoja(dados);
        })
        .withFailureHandler(function(error) {
          console.error("❌ Erro ao buscar loja:", error);
        })
        .buscarDadosLoja(nomeLoja);
    }

    // Fechar sugestões quando clicar fora
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.search-container')) {
        document.getElementById('suggestions').style.display = 'none';
      }
    });

    // ⭐⭐ PREENCHER DADOS DA LOJA ⭐⭐
    function preencherDadosLoja(dados) {
      console.log("📊 Dados recebidos:", dados);
      
      // Esconder todas as mensagens primeiro
      document.getElementById('messageLojaNaoEncontrada').style.display = 'none';
      document.getElementById('messageSuccess').style.display = 'none';

      if (!dados || !dados.encontrado) {
        lojaExiste = false;
        registroId = null;
        document.getElementById('secaoAtualizacao').style.display = 'none';
        document.getElementById('btnCadastrar').style.display = 'block';
        document.getElementById('btnAtualizar').style.display = 'none';
        document.getElementById('defasagem-info').style.display = 'none';
        document.getElementById('data-retorno-info').style.display = 'none';
        
        // ⬇️ MOSTRAR MENSAGEM DE LOJA NÃO ENCONTRADA ⬇️
        const nomeLoja = document.getElementById('loja').value.trim();
        if (nomeLoja) {
          document.getElementById('messageLojaNaoEncontrada').style.display = 'flex';
        }
        return;
      }

      lojaExiste = true;
      registroId = dados.id;
      
      document.getElementById('segmento').value = dados.segmento || '';
      document.getElementById('telefone').value = dados.telefone || '';
      
      if (dados.fornecedor) {
        const fornecedores = dados.fornecedor.split(',').map(f => f.trim());
        const checkboxes = document.querySelectorAll('#fornecedor-container input');
        checkboxes.forEach(checkbox => {
          checkbox.checked = fornecedores.includes(checkbox.value);
          checkbox.parentElement.classList.toggle('selected', checkbox.checked);
        });
        atualizarFornecedorSelecionado();
      }
      
      document.getElementById('trafego').value = dados.trafego || '';
      document.getElementById('quantidade_lojas').value = dados.quantidade_lojas || '';
      
      // ⬇️ CORREÇÃO: ADESÃO COMO NÚMERO PARA O SELECT
      document.getElementById('adesao').value = dados.adesao || '0';
      
      if (dados.data_pagamento_adesao) {
        document.getElementById('data_pagamento_adesao').value = dados.data_pagamento_adesao;
      }
      
      document.getElementById('forma_pagamento').value = dados.forma_pagamento || '';
      document.getElementById('parcelas').value = dados.parcelas || '';
      document.getElementById('plano_assinatura').value = dados.plano_assinatura || '';
      document.getElementById('usuario').value = dados.usuario || '';
      
      // ⬇️ NOVOS CAMPOS
      document.getElementById('representante').value = dados.representante || '';
      
      if (dados.data_retorno_cliente) {
        document.getElementById('data_retorno_cliente').value = dados.data_retorno_cliente;
      }
      
      document.getElementById('status').value = dados.status || 'Em andamento';
      document.getElementById('evento').value = dados.evento || '';
      document.getElementById('observacao').value = dados.observacao || '';

      if (dados.defasagem !== undefined) {
        document.getElementById('defasagem-dias').textContent = dados.defasagem;
        document.getElementById('defasagem-info').style.display = 'block';
      }

      if (dados.data_retorno_cliente && dados.data_retorno_cliente !== 'N/A') {
        document.getElementById('data-retorno-dias').textContent = dados.data_retorno_cliente;
        document.getElementById('data-retorno-info').style.display = 'block';
      }

      document.getElementById('secaoAtualizacao').style.display = 'block';
      document.getElementById('btnCadastrar').style.display = 'none';
      document.getElementById('btnAtualizar').style.display = 'block';
      
      showMessage('success', '✅ Loja encontrada! Modo de atualização ativado.');
    }

    // ⭐⭐ CADASTRAR LOJA - VERSÃO CORRIGIDA ⭐⭐
function cadastrarLoja() {
  if (!validarFormulario()) return;

  const dados = coletarDadosFormulario();
  dados.acao = 'cadastrar';

  const btnCadastrar = document.getElementById('btnCadastrar');
  btnCadastrar.innerHTML = '<div class="loading"><div class="spinner"></div> Salvando...</div>';
  btnCadastrar.disabled = true;

  google.script.run
    .withSuccessHandler(function(res) {
      btnCadastrar.innerHTML = '<i class="fas fa-plus-circle"></i> Cadastrar Loja';
      btnCadastrar.disabled = false;
      
      if(res && res.success) {
        // ⬇️ MENSAGEM COMPLETA COM ID ⬇️
        const nomeLoja = document.getElementById('loja').value.trim();
        const mensagem = `✅ Loja "${nomeLoja}" cadastrada com sucesso! ${res.message || ''}`;
        showMessage('success', mensagem);
        limparDados();
        carregarLojasParaAutocomplete();
      } else {
        showMessage('error', res.message || 'Erro ao cadastrar');
      }
    })
    .withFailureHandler(function(error) {
      btnCadastrar.innerHTML = '<i class="fas fa-plus-circle"></i> Cadastrar Loja';
      btnCadastrar.disabled = false;
      showMessage('error', '❌ Erro: ' + error.message);
    })
    .salvarProspeccao(dados);
}

    // ⭐⭐ ATUALIZAR REGISTRO ⭐⭐
    function atualizarRegistro() {
      if (!validarFormulario()) return;

      const dados = coletarDadosFormulario();
      dados.acao = 'atualizar';
      dados.id = registroId;

      const btnAtualizar = document.getElementById('btnAtualizar');
      btnAtualizar.innerHTML = '<div class="loading"><div class="spinner"></div> Atualizando...</div>';
      btnAtualizar.disabled = true;

      google.script.run
        .withSuccessHandler(function(res) {
          btnAtualizar.innerHTML = '<i class="fas fa-save"></i> Atualizar Registro';
          btnAtualizar.disabled = false;
          
          if(res && res.success) {
            showMessage('success', res.message);
          } else {
            showMessage('error', res.message || 'Erro ao atualizar');
          }
        })
        .withFailureHandler(function(error) {
          btnAtualizar.innerHTML = '<i class="fas fa-save"></i> Atualizar Registro';
          btnAtualizar.disabled = false;
          showMessage('error', '❌ Erro: ' + error.message);
        })
        .salvarProspeccao(dados);
    }

    // ⭐⭐ VALIDAÇÃO DE FORMULÁRIO ⭐⭐
    function validarFormulario() { 
      let isValid = true;
      
      // Lista de campos obrigatórios
      const requiredFields = [
        'loja', 'segmento', 'telefone', 'trafego', 
        'quantidade_lojas', 'adesao', 'forma_pagamento', 
        'parcelas', 'plano_assinatura', 'usuario'
      ];

      // Limpar mensagens de erro anteriores
      requiredFields.forEach(field => {
        const element = document.getElementById(field);
        const errorElement = document.getElementById(`erro-${field}`);
        element.classList.remove('error');
        errorElement.style.display = 'none';
      });

      // Validar cada campo
      requiredFields.forEach(field => {
        const element = document.getElementById(field);
        const errorElement = document.getElementById(`erro-${field}`);
        const value = element.value.trim();
        
        if (!value) {
          element.classList.add('error');
          errorElement.style.display = 'block';
          isValid = false;
          
          // Scroll para o primeiro campo com erro
          if (isValid === false) {
            element.scrollIntoView({ behavior: 'smooth', block: 'center' });
            element.focus();
          }
        }
      });

      // Validar fornecedor (campo especial)
      const fornecedorCheckboxes = document.querySelectorAll('#fornecedor-container input:checked');
      const fornecedorError = document.getElementById('erro-fornecedor');
      if (fornecedorCheckboxes.length === 0) {
        document.getElementById('fornecedor-container').style.border = '2px solid var(--danger)';
        document.getElementById('fornecedor-container').style.borderRadius = '10px';
        document.getElementById('fornecedor-container').style.padding = '10px';
        fornecedorError.style.display = 'block';
        isValid = false;
      } else {
        document.getElementById('fornecedor-container').style.border = '';
        document.getElementById('fornecedor-container').style.padding = '';
        fornecedorError.style.display = 'none';
      }

      // Validar seção de atualização (se visível)
      if (document.getElementById('secaoAtualizacao').style.display !== 'none') {
        const updateFields = ['status', 'evento', 'observacao'];
        updateFields.forEach(field => {
          const element = document.getElementById(field);
          const errorElement = document.getElementById(`erro-${field}`);
          const value = element.value.trim();
          
          if (!value) {
            element.classList.add('error');
            errorElement.style.display = 'block';
            isValid = false;
          }
        });
      }

      if (!isValid) {
        showMessage('error', '⚠️ Preencha todos os campos obrigatórios!');
        return false;
      }

      return true;
    }

    // ⭐⭐ COLETAR DADOS DO FORMULÁRIO ⭐⭐
    function coletarDadosFormulario() { 
      const fornecedorCheckboxes = document.querySelectorAll('#fornecedor-container input:checked');
      const fornecedores = Array.from(fornecedorCheckboxes).map(cb => cb.value);
      
      return {
        loja: document.getElementById('loja').value.trim(),
        segmento: document.getElementById('segmento').value,
        telefone: document.getElementById('telefone').value,
        fornecedor: fornecedores.join(', '),
        trafego: document.getElementById('trafego').value,
        quantidade_lojas: document.getElementById('quantidade_lojas').value,
        adesao: document.getElementById('adesao').value,
        data_pagamento_adesao: document.getElementById('data_pagamento_adesao').value,
        forma_pagamento: document.getElementById('forma_pagamento').value,
        parcelas: document.getElementById('parcelas').value,
        plano_assinatura: document.getElementById('plano_assinatura').value,
        usuario: document.getElementById('usuario').value,
        representante: document.getElementById('representante').value,
        data_retorno_cliente: document.getElementById('data_retorno_cliente').value,
        status: document.getElementById('status').value,
        evento: document.getElementById('evento').value,
        observacao: document.getElementById('observacao').value
      };
    }

    // ⭐⭐ LIMPAR DADOS ⭐⭐
    function limparDados() {
      console.log("🧹 Limpando todos os dados...");

      // ⬇️ ESCONDER MENSAGENS
      document.getElementById('messageLojaNaoEncontrada').style.display = 'none';
      document.getElementById('messageSuccess').style.display = 'none';
      document.getElementById('messageError').style.display = 'none';
      
      // Limpar campo principal
      document.getElementById('loja').value = '';
      
      // Limpar todos os campos do formulário
      document.getElementById('segmento').value = '';
      document.getElementById('telefone').value = '';
      document.getElementById('trafego').value = '';
      document.getElementById('quantidade_lojas').value = '';
      document.getElementById('adesao').value = '0';
      document.getElementById('data_pagamento_adesao').value = '';
      document.getElementById('forma_pagamento').value = '';
      document.getElementById('parcelas').value = '';
      document.getElementById('plano_assinatura').value = '';
      document.getElementById('usuario').value = '';
      document.getElementById('representante').value = '';
      document.getElementById('data_retorno_cliente').value = '';
      document.getElementById('status').value = 'Em andamento';
      document.getElementById('evento').value = '';
      document.getElementById('observacao').value = '';
      
      // Limpar checkboxes de fornecedor
      const checkboxes = document.querySelectorAll('#fornecedor-container input');
      checkboxes.forEach(checkbox => {
        checkbox.checked = false;
        checkbox.parentElement.classList.remove('selected');
      });
      document.getElementById('fornecedor').value = '';
      
      // Resetar variáveis globais
      lojaExiste = false;
      registroId = null;
      
      // Resetar interface
      document.getElementById('secaoAtualizacao').style.display = 'none';
      document.getElementById('btnCadastrar').style.display = 'block';
      document.getElementById('btnAtualizar').style.display = 'none';
      document.getElementById('defasagem-info').style.display = 'none';
      document.getElementById('data-retorno-info').style.display = 'none';
      
      // Fechar sugestões
      document.getElementById('suggestions').style.display = 'none';
      
      // Limpar mensagens de erro
      const errorMessages = document.querySelectorAll('.error-message');
      errorMessages.forEach(msg => msg.style.display = 'none');
      
      const errorFields = document.querySelectorAll('.form-control.error');
      errorFields.forEach(field => field.classList.remove('error'));
      
      // Focar no campo loja
      document.getElementById('loja').focus();
      
      showMessage('success', '🧹 Todos os dados foram limpos!');
      
      console.log("✅ Dados limpos com sucesso!");
    }

    // ⭐⭐ FUNÇÕES AUXILIARES ⭐⭐
    function inicializarMultiSelect() { 
      const options = document.querySelectorAll('.multi-select-option');
      options.forEach(option => {
        option.addEventListener('click', function() {
          const checkbox = this.querySelector('input');
          checkbox.checked = !checkbox.checked;
          this.classList.toggle('selected', checkbox.checked);
          atualizarFornecedorSelecionado();
        });
      });
    }

    function atualizarFornecedorSelecionado() { 
      const selected = document.querySelectorAll('#fornecedor-container input:checked');
      const values = Array.from(selected).map(cb => cb.value);
      document.getElementById('fornecedor').value = values.join(', ');
    }

    function formatarTelefone(input) { 
      let value = input.value.replace(/\D/g, '');
      if (value.length > 10) {
        value = value.replace(/^(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
      } else if (value.length > 5) {
        value = value.replace(/^(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3');
      } else if (value.length > 2) {
        value = value.replace(/^(\d{2})(\d{0,5})/, '($1) $2');
      }
      input.value = value;
    }

    function formatarMoeda(input) { 
      let value = input.value.replace(/\D/g, '');
      value = (value / 100).toFixed(2);
      value = value.replace('.', ',');
      value = value.replace(/(\d)(?=(\d{3})+\,)/g, "$1.");
      input.value = 'R$ ' + value;
    }

    function showMessage(type, text) {
      const successEl = document.getElementById('messageSuccess');
      const errorEl = document.getElementById('messageError');
      const infoEl = document.getElementById('messageInfo');

      successEl.style.display = 'none';
      errorEl.style.display = 'none';
      infoEl.style.display = 'none';

      switch(type) {
        case 'success':
          successEl.querySelector('span').textContent = text;
          successEl.style.display = 'flex';
          break;
        case 'error':
          errorEl.querySelector('span').textContent = text;
          errorEl.style.display = 'flex';
          setTimeout(() => errorEl.style.display = 'none', 5000);
          break;
        case 'info':
          infoEl.querySelector('span').textContent = text;
          infoEl.style.display = 'flex';
          setTimeout(() => infoEl.style.display = 'none', 5000);
          break;
      }
    }
  </script>
