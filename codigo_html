// 🔥 FUNÇÃO CORRIGIDA: ATUALIZAR INFORMAÇÕES DE CÁLCULO COMPLETO
function atualizarInformacoesCalculoCompleto(dataRetornoCliente, dataUltimoEvento, defasagemExistente, status) {
    const dataBaseElement = document.getElementById('data-base-calculo');
    const tipoCalculoElement = document.getElementById('tipo-calculo-text');
    const tipoCalculoInfo = document.getElementById('tipo-calculo-info');
    
    console.log("🔍 ATUALIZANDO INFORMAÇÕES DE CÁLCULO - STATUS:", status);
    console.log("Data retorno:", dataRetornoCliente);
    console.log("Data último evento:", dataUltimoEvento);
    console.log("Defasagem existente:", defasagemExistente);
    
    // 🔥🔥🔥 CORREÇÃO: VERIFICA SE STATUS É ENCERRADO
    const statusNormalizado = String(status).toUpperCase().trim();
    const statusEncerrado = statusNormalizado.includes('CONCLUIDO') && 
                           (statusNormalizado.includes('NAO') || statusNormalizado.includes('NÃO') || 
                            !statusNormalizado.includes('NAO') && !statusNormalizado.includes('NÃO'));
    
    let calculoDefasagem;
    let defasagemCalculada;
    
    if (statusEncerrado) {
        // 🔥 STATUS ENCERRADO - DEFASAGEM ZERO
        defasagemCalculada = 0;
        calculoDefasagem = { dias: 0, tipo: 'encerrado' };
        console.log("✅ Status encerrado - Defasagem forçada para 0");
    } else {
        // 🔥 STATUS NORMAL - CALCULA NORMALMENTE
        calculoDefasagem = calcularDefasagemIgualCards(dataRetornoCliente, dataUltimoEvento, status);
        defasagemCalculada = calculoDefasagem.dias;
        console.log("📊 Defasagem calculada:", defasagemCalculada, "dias");
    }
    
    console.log("📊 Tipo de cálculo:", calculoDefasagem.tipo);
    
    // ATUALIZAR DEFASAGEM NA TELA
    document.getElementById('defasagem-dias').textContent = defasagemCalculada;
    
    // MOSTRAR/OCULTAR DEFASAGEM
    if (defasagemCalculada > 0) {
        document.getElementById('defasagem-info').style.display = 'block';
        console.log("⚠️ Defasagem mostrada:", defasagemCalculada, "dias");
    } else {
        document.getElementById('defasagem-info').style.display = 'none';
        console.log("✅ Sem defasagem");
    }
    
    // ATUALIZAR INFORMAÇÕES DE CÁLCULO
    if (calculoDefasagem.tipo === 'data_retorno') {
