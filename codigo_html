  // ⭐⭐ FUNÇÃO: FILTRAR TODAS AS LOJAS - CORRIGIDA ⭐⭐
function filtrarTodasLojas() {
    const termo = document.getElementById('pesquisaTodas').value.toLowerCase();
    const criterioStatus = document.getElementById('ordenacaoTodas').value;
    
    let lojasFiltradas = todasLojasCompletas.filter(loja => 
        loja.loja && loja.loja.toLowerCase().includes(termo)
    );
    
    // 🔥 CORREÇÃO: APLICA FILTRO DE STATUS COM NORMALIZAÇÃO
    if (criterioStatus !== 'todas' && criterioStatus !== 'alfabetica') {
        lojasFiltradas = lojasFiltradas.filter(loja => {
            if (!loja.status) return false;
            
            // 🔥 NORMALIZAR STATUS (remove acentos, coloca maiúsculo)
            const statusLoja = loja.status
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // Remove acentos
                .toUpperCase()
                .trim();
                
            const criterioNormalizado = criterioStatus
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // Remove acentos  
                .toUpperCase()
                .trim();
            
            return statusLoja === criterioNormalizado;
        });
    }
    
    // Ordena alfabeticamente se selecionado
    if (criterioStatus === 'alfabetica') {
        lojasFiltradas.sort((a, b) => (a.loja || '').localeCompare(b.loja || ''));
    }
    
    const gridTodas = document.getElementById('gridTodas');
    gridTodas.innerHTML = '';
    
    if (lojasFiltradas.length === 0) {
        gridTodas.innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--gray);">
                <i class="fas fa-search" style="font-size: 3rem; margin-bottom: 15px;"></i>
                <h3>Nenhuma loja encontrada</h3>
                <p>Nenhuma loja corresponde aos filtros aplicados</p>
            </div>
        `;
    } else {
        lojasFiltradas.forEach(loja => {
            const card = criarCardTodas(loja);
            gridTodas.appendChild(card);
        });
    }
    
    atualizarContador('contadorTodas', lojasFiltradas.length);
}

