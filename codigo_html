function filtrarPorStatus() {
    const criterio = document.getElementById('ordenacaoTodas').value;
    let lojasFiltradas = [...todasLojasCompletas];
    
    console.log("🎯 Filtrando por:", criterio);
    
    if (criterio === 'todas') {
        // Mostra todas as lojas sem filtro
        lojasFiltradas = [...todasLojasCompletas];
    } 
    else if (criterio === 'alfabetica') {
        // Ordena alfabeticamente
        lojasFiltradas.sort((a, b) => (a.loja || '').localeCompare(b.loja || ''));
    }
    else {
        // 🔥 CORREÇÃO: FILTRA POR STATUS COM NORMALIZAÇÃO
        lojasFiltradas = todasLojasCompletas.filter(loja => {
            if (!loja.status) return false;
            
            // Normaliza ambos os lados para comparação
            const statusLoja = loja.status
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // Remove acentos
                .toUpperCase()
                .trim();
                
            const criterioNormalizado = criterio
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // Remove acentos  
                .toUpperCase()
                .trim();
            
            return statusLoja === criterioNormalizado;
        });
    }
    
    const gridTodas = document.getElementById('gridTodas');
    gridTodas.innerHTML = '';
    
    if (lojasFiltradas.length === 0) {
        gridTodas.innerHTML = `
