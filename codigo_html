<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistema de Prospecções - SIM CRED</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }
    
    :root {
      --primary: #7E3E9A;
      --secondary: #A1CC4C;
      --accent: #FF6B35;
      --dark: #2D3047;
      --light: #FFFFFF;
      --success: #28A745;
      --warning: #FFC107;
      --danger: #DC3545;
      --gray: #6C757D;
      --border: #E0E0E0;
      --background: #F8F9FA;
    }
    
    body {
      background: var(--background);
      min-height: 100vh;
      padding: 20px;
      color: var(--dark);
    }
    
    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: var(--light);
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      overflow: hidden;
    }
    
    .header {
      background: var(--primary);
      padding: 30px 40px;
      color: white;
      text-align: center;
      position: relative;
    }
    
    .logo-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
      margin-bottom: 10px;
    }
    
    .logo {
      width: 120px;
      height: 120px;
      background: white;
      padding: 15px;
      border-radius: 20px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
      object-fit: contain;
    }
    
    .header-content {
      text-align: center;
    }
    
    h1 {
      font-size: 2.8rem;
      font-weight: 700;
      margin-bottom: 10px;
      color: white;
    }
    
    .subtitle {
      font-size: 1.3rem;
      opacity: 0.9;
      margin-bottom: 15px;
      color: white;
    }
    
    .version {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.2);
      padding: 10px 20px;
      border-radius: 25px;
      font-size: 1rem;
      backdrop-filter: blur(10px);
      color: white;
    }
    
    .content {
      padding: 40px;
    }
    
    .card {
      background: var(--light);
      border-radius: 12px;
      padding: 30px;
      margin-bottom: 25px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      border: 1px solid var(--border);
    }
    
    .card-header {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 25px;
      padding-bottom: 15px;
      border-bottom: 3px solid var(--primary);
    }
    
    .card-header i {
      color: var(--primary);
      font-size: 1.8rem;
    }
    
    .card-title {
      font-size: 1.6rem;
      font-weight: 600;
      color: var(--primary);
      margin: 0;
    }
    
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 25px;
      margin-bottom: 25px;
    }
    
    .form-group {
      margin-bottom: 25px;
      position: relative;
    }
    
    .form-label {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
      font-weight: 600;
      color: var(--dark);
      font-size: 1.1rem;
    }
    
    .form-label i {
      color: var(--primary);
      width: 20px;
      text-align: center;
    }
    
    .required::after {
      content: " *";
      color: var(--danger);
    }
    
    .form-control {
      width: 100%;
      padding: 14px 16px;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 1.05rem;
      transition: all 0.3s ease;
      background: var(--light);
    }
    
    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(126, 62, 154, 0.1);
    }
    
    .form-control.error {
      border-color: var(--danger);
      box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
    }
    
    textarea.form-control {
      min-height: 120px;
      resize: vertical;
      line-height: 1.5;
    }
    
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 14px 28px;
      border: none;
      border-radius: 10px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      min-width: 140px;
      justify-content: center;
    }
    
    .btn-primary {
      background: var(--primary);
      color: white;
    }
    
    .btn-primary:hover {
      background: #6a2e82;
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(126, 62, 154, 0.3);
    }
    
    .btn-secondary {
      background: var(--secondary);
      color: white;
    }
    
    .btn-secondary:hover {
      background: #8fb83a;
      transform: translateY(-2px);
    }
    
    .btn-warning {
      background: var(--warning);
      color: var(--dark);
    }
    
    .btn-warning:hover {
      background: #e0a800;
      transform: translateY(-2px);
    }
    
    .btn-danger {
      background: var(--danger);
      color: white;
    }
    
    .btn-danger:hover {
      background: #c82333;
      transform: translateY(-2px);
    }
    
    .btn-info {
      background: #17a2b8;
      color: white;
    }
    
    .btn-info:hover {
      background: #138496;
      transform: translateY(-2px);
    }
    
    .btn-group {
      display: flex;
      gap: 15px;
      margin-top: 30px;
      flex-wrap: wrap;
    }
    
    .btn-group .btn {
      flex: 1;
      min-width: 200px;
    }
    
    .message {
      padding: 18px 24px;
      border-radius: 10px;
      margin: 20px 0;
      display: none;
      align-items: center;
      gap: 15px;
      font-weight: 600;
      font-size: 1.1rem;
    }
    
    .message i {
      font-size: 1.4rem;
    }
    
    .success {
      background: #d4edda;
      color: var(--success);
      border: 1px solid #c3e6cb;
    }
    
    .error {
      background: #f8d7da;
      color: var(--danger);
      border: 1px solid #f5c6cb;
    }
    
    .info {
      background: #d1ecf1;
      color: #0c5460;
      border: 1px solid #bee5eb;
    }
    
    .loading {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--primary);
    }
    
    .spinner {
      width: 18px;
      height: 18px;
      border: 2px solid #f3f3f3;
      border-top: 2px solid var(--primary);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }
    
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    .loja-exists {
      border-color: var(--warning);
      background: #fffbf0;
    }
    
    .defasagem-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      background: var(--danger);
      color: white;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 600;
      margin-left: 15px;
    }
    
    .search-container {
      position: relative;
    }

    .suggestions {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: white;
      border: 1px solid var(--primary);
      border-top: none;
      border-radius: 0 0 10px 10px;
      z-index: 1000;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      margin-top: -2px;
    }

    .suggestion-item {
      padding: 12px 16px;
      cursor: pointer;
      border-bottom: 1px solid var(--border);
      transition: all 0.2s ease;
      font-size: 1rem;
      font-weight: 500;
    }

    .suggestion-item:hover {
      background: var(--primary);
      color: white;
      font-weight: 600;
    }

    .suggestion-item:last-child {
      border-bottom: none;
    }
    
    .action-buttons {
      display: flex;
      gap: 15px;
      margin-top: 20px;
      flex-wrap: wrap;
    }
    
    .multi-select {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 5px;
    }
    
    .multi-select-option {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 8px 12px;
      background: #f8f9fa;
      border: 1px solid var(--border);
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .multi-select-option.selected {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }
    
    .multi-select-option input {
      display: none;
    }
    
    .error-message {
      color: var(--danger);
      font-size: 0.9rem;
      margin-top: 5px;
      display: none;
      font-weight: 500;
    }

    /* ⭐⭐ NOVOS ESTILOS PARA A SEÇÃO DE LOJAS ⭐⭐ */
    .btn-ver-loja {
      background: #FFD700 !important;
      color: #333 !important;
      border: 2px solid #FFC107 !important;
      font-weight: 700 !important;
    }

    .btn-ver-loja:hover {
      background: #FFC107 !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 8px 20px rgba(255, 193, 7, 0.3) !important;
    }

    .lojas-container {
      margin-top: 30px;
      padding: 25px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      border: 2px solid var(--primary);
    }

    .lojas-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    .loja-card {
      background: white;
      border-radius: 10px;
      padding: 20px;
      border: 2px solid var(--border);
      transition: all 0.3s ease;
      position: relative;
    }

    .loja-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .loja-card.em-andamento {
      border-left: 5px solid var(--warning);
    }

    .loja-card.concluido {
      border-left: 5px solid var(--success);
    }

    .loja-card.nao-concluido {
      border-left: 5px solid var(--danger);
    }

    .loja-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 15px;
    }

    .loja-nome {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--dark);
      margin-bottom: 5px;
    }

    .loja-status {
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
    }

    .status-em-andamento {
      background: #FFF3CD;
      color: #856404;
    }

    .status-concluido {
      background: #D1E7DD;
      color: #0F5132;
    }

    .status-nao-concluido {
      background: #F8D7DA;
      color: #721C24;
    }

    .loja-info {
      margin-bottom: 10px;
      font-size: 0.95rem;
    }

    .loja-info strong {
      color: var(--primary);
    }

    .loja-defasagem {
      background: var(--danger);
      color: white;
      padding: 4px 10px;
      border-radius: 15px;
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .loja-ultimo-evento {
      font-style: italic;
      color: var(--gray);
      font-size: 0.9rem;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid var(--border);
    }

    .data-retorno-info {
      background: #E7F3FF;
      color: #0D6EFD;
      padding: 4px 10px;
      border-radius: 15px;
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    
    @media (max-width: 768px) {
      .content {
        padding: 20px;
      }
      
      .form-grid {
        grid-template-columns: 1fr;
      }
      
      .btn-group {
        flex-direction: column;
      }
      
      .header {
        padding: 20px;
      }
      
      h1 {
        font-size: 2.2rem;
      }
      
      .logo {
        width: 80px;
        height: 80px;
      }

      .lojas-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo-container">
        <img src="https://i.ibb.co/B2r5xtbS/sim-cred-5.png" class="logo" alt="SIM CRED">
        <div class="header-content">
          <h1>Sistema de Prospecções</h1>
          <div class="subtitle">Cadastro e Acompanhamento de Lojas</div>
          <div class="version">
            <i class="fas fa-rocket"></i>
            Versão 2.1 - Sistema de Eventos com Data de Retorno
          </div>
        </div>
      </div>
    </div>
    
    <div class="content">
      <!-- ⭐⭐ BOTÃO VER LOJA ⭐⭐ -->
      <div class="action-buttons" style="margin-bottom: 20px;">
        <button type="button" class="btn btn-ver-loja" onclick="mostrarTodasLojas()" id="btnVerLojas">
          <i class="fas fa-store"></i>
          Ver Lojas
        </button>

 
</div>
      </div>

      <div class="card">
        <div class="card-header">
          <i class="fas fa-search"></i>
          <h2 class="card-title">Busca de Loja</h2>
        </div>
        
        <div class="form-group">
          <label class="form-label required">
            <i class="fas fa-store"></i>
            Loja
          </label>
          <div class="search-container">
            <input type="text" id="loja" class="form-control" 
                   placeholder="Digite o nome da loja..."
                   autocomplete="off"
                   oninput="filtrarLojas(this.value)"
                   onfocus="filtrarLojas(this.value)">
            <div class="suggestions" id="suggestions">
              <!-- Sugestões aparecerão aqui automaticamente -->
            </div>
          </div>
          <div class="error-message" id="erro-loja">Campo obrigatório</div>
        </div>
        
        <div class="action-buttons">
          <button type="button" class="btn btn-secondary" onclick="buscarLoja()" id="btnBuscar">
            <i class="fas fa-search"></i>
            Buscar Loja
          </button>
          <button type="button" class="btn btn-danger" onclick="limparDados()" id="btnLimpar">
            <i class="fas fa-broom"></i>
            Limpar Dados
          </button>
        </div>
        
        <div id="messageLojaNaoEncontrada" class="message info" style="display: none;">
          <i class="fas fa-info-circle"></i>
          <span>Loja não encontrada! Você pode cadastrá-la agora.</span>
        </div>
      </div>
      
      <div class="card">
        <div class="card-header">
          <i class="fas fa-info-circle"></i>
          <h2 class="card-title">Dados da Loja</h2>
        </div>
        
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label required">
              <i class="fas fa-tag"></i>
              Segmento
            </label>
            <select id="segmento" class="form-control" required>
              <option value="">-- Selecione --</option>
              <option value="Atacadista">Atacadista</option>
              <option value="Ótica">Ótica</option>
              <option value="Material de construção">Material de construção</option>
              <option value="Telefonia">Telefonia</option>
              <option value="Vestuário">Vestuário</option>
              <option value="Móveis e eletros">Móveis e eletros</option>
              <option value="Auto Peças">Auto Peças</option>
              <option value="Calçados">Calçados</option>
              <option value="Construções">Construções</option>
              <option value="Eletrônicos">Eletrônicos</option>
              <option value="Confecções">Confecções</option>
              <option value="Cosméticos">Cosméticos</option>
              <option value="Postos de combustível">Postos de combustível</option>
              <option value="Supermercado">Supermercado</option>
              <option value="Drogarias Individuas e por rede">Drogarias Individuas e por rede</option>
              <option value="Materiais de contrações">Materiais de contrações</option>
              <option value="Piscinas(exceto RJ)">Piscinas(exceto RJ)</option>
            </select>
            <div class="error-message" id="erro-segmento">Campo obrigatório</div>
          </div>
          
          <div class="form-group">
            <label class="form-label required">
              <i class="fas fa-phone"></i>
              Telefone
            </label>
            <input type="text" id="telefone" class="form-control" required placeholder="(21) 99596-8380" oninput="formatarTelefone(this)">
            <div class="error-message" id="erro-telefone">Campo obrigatório</div>
          </div>
          
          <div class="form-group">
            <label class="form-label required">
              <i class="fas fa-truck"></i>
              Fornecedor
            </label>
            <div class="multi-select" id="fornecedor-container">
              <label class="multi-select-option">
                <input type="checkbox" value="BC"> BC
              </label>
              <label class="multi-select-option">
                <input type="checkbox" value="Ágil"> Ágil
              </label>
              <label class="multi-select-option">
                <input type="checkbox" value="Jeitoo"> Jeitoo
              </label>
              <label class="multi-select-option">
                <input type="checkbox" value="crefaz"> crefaz
              </label>
            </div>
            <input type="hidden" id="fornecedor">
            <div class="error-message" id="erro-fornecedor">Selecione pelo menos um fornecedor</div>
          </div>
          
          <div class="form-group">
            <label class="form-label required">
              <i class="fas fa-car"></i>
              Tráfego apenas
            </label>
            <select id="trafego" class="form-control" required>
              <option value="">-- Selecione --</option>
              <option value="Sim">Sim</option>
              <option value="Não">Não</option>
            </select>
            <div class="error-message" id="erro-trafego">Campo obrigatório</div>
          </div>
          
          <div class="form-group">
            <label class="form-label required">
              <i class="fas fa-building"></i>
              Quantidade de lojas
            </label>
            <input type="number" id="quantidade_lojas" class="form-control" required min="1" placeholder="Apenas números">
            <div class="error-message" id="erro-quantidade_lojas">Campo obrigatório</div>
          </div>
          
          <div class="form-group">
            <label class="form-label required">
              <i class="fas fa-money-bill-wave"></i>
              Adesão
            </label>
            <select id="adesao" class="form-control" required>
              <option value="0">R$ 0,00</option>
              <option value="499">R$ 499,00</option>
              <option value="599">R$ 599,00</option>
              <option value="699">R$ 699,00</option>
              <option value="799">R$ 799,00</option>
              <option value="899">R$ 899,00</option>
              <option value="999">R$ 999,00</option>
              <option value="1299">R$ 1.299,00</option>
            </select>
            <div class="error-message" id="erro-adesao">Campo obrigatório</div>
          </div>
          
          <div class="form-group">
            <label class="form-label">
              <i class="fas fa-calendar-day"></i>
              Data pagamento adesão
            </label>
            <input type="date" id="data_pagamento_adesao" class="form-control">
          </div>
          
          <div class="form-group">
            <label class="form-label required">
              <i class="fas fa-credit-card"></i>
              Forma de pagamento
            </label>
            <select id="forma_pagamento" class="form-control" required>
              <option value="">-- Selecione --</option>
              <option value="Pix">Pix</option>
              <option value="Cartão">Cartão</option>
              <option value="Boleto">Boleto</option>
            </select>
            <div class="error-message" id="erro-forma_pagamento">Campo obrigatório</div>
          </div>
          
          <div class="form-group">
            <label class="form-label required">
              <i class="fas fa-calendar-alt"></i>
              Parcelas
            </label>
            <select id="parcelas" class="form-control" required>
              <option value="">-- Selecione --</option>
              <option value="1x">1x</option>
              <option value="2x">2x</option>
              <option value="3x">3x</option>
              <option value="4x">4x</option>
            </select>
            <div class="error-message" id="erro-parcelas">Campo obrigatório</div>
          </div>
          
          <div class="form-group">
            <label class="form-label required">
              <i class="fas fa-chart-line"></i>
              Plano de assinatura
            </label>
            <input type="text" id="plano_assinatura" class="form-control" required placeholder="R$ 0,00" oninput="formatarMoeda(this)">
            <div class="error-message" id="erro-plano_assinatura">Campo obrigatório</div>
          </div>
          
          <div class="form-group">
            <label class="form-label required">
              <i class="fas fa-user"></i>
              Usuário
            </label>
            <select id="usuario" class="form-control" required>
              <option value="">-- Selecione --</option>
              <option value="João">João</option>
              <option value="Ana">Ana</option>
              <option value="Luana">Luana</option>
            </select>
            <div class="error-message" id="erro-usuario">Campo obrigatório</div>
          </div>
          
          <!-- ⭐⭐ MUDANÇA 1: REPRESENTANTE / COMERCIAL INTERNO ⭐⭐ -->
          <div class="form-group">
            <label class="form-label">
              <i class="fas fa-user-tie"></i>
              Representante / Comercial Interno
            </label>
            <input type="text" id="representante" class="form-control" placeholder="Nome do representante (opcional)">
          </div>

          <!-- ⭐⭐ NOVO CAMPO: DATA RETORNO CLIENTE ⭐⭐ -->
          <div class="form-group">
            <label class="form-label">
              <i class="fas fa-calendar-check"></i>
              Data retorno cliente
            </label>
            <input type="date" id="data_retorno_cliente" class="form-control">
            <small style="color: var(--gray); font-size: 0.85rem; margin-top: 5px; display: block;">
              Data que o cliente disse que retornaria o contato
