        <div class="form-group" id="defasagem-info" style="display: none;">
          <label class="form-label">
            <i class="fas fa-clock"></i>
            Defasagem
          </label>
          <div class="defasagem-badge">
            <i class="fas fa-exclamation-triangle"></i>
            <span id="defasagem-dias">0</span> dias sem contato
          </div>
        </div>

        <!-- ⭐⭐ NOVA INFO: DATA RETORNO CLIENTE ⭐⭐ -->
        <div class="form-group" id="data-retorno-info" style="display: none;">
          <label class="form-label">
            <i class="fas fa-calendar-day"></i>
            Data retorno cliente
          </label>
          <div class="data-retorno-info">
            <i class="fas fa-calendar"></i>
            <span id="data-retorno-dias">Não informada</span>
          </div>
        </div>
