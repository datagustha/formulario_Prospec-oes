<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistema de Prospecções - SIM CRED</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* 🔥 SUBSTITUA POR: */
#loadingOverlay {
  display: none;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.7);
  z-index: 9999;
  justify-content: center;
  align-items: center;
}

    #loadingOverlay.show {
      display: flex !important;
    }
    
    :root {
      --primary: #7E3E9A;
      --secondary: #A1CC4C;
      --accent: #FF6B35;
      --dark: #2D3047;
      --light: #FFFFFF;
      --success: #28A745;
      --warning: #FFC107;
      --danger: #DC3545;
      --info: #17A2B8;
      --gray: #6C757D;
      --border: #E0E0E0;
      --background: #F8F9FA;
    }
    
    body {
      background: var(--background);
      min-height: 100vh;
      padding: 20px;
      color: var(--dark);
      overflow-y: auto; /* 🔄 ADICIONANDO SCROLL */
    }
    
    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: var(--light);
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      overflow: hidden;
    }
    
    .header {
  background: var(--primary);
  padding: 30px 40px;
  color: white;
  text-align: center;
  
}
    
    .logo-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
      margin-bottom: 10px;
    }
    
    .logo {
      width: 120px;
      height: 120px;
      background: white;
      padding: 15px;
      border-radius: 20px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
      object-fit: contain;
    }
    
    .header-content {
      text-align: center;
    }
    
    h1 {
      font-size: 2.8rem;
      font-weight: 700;
      margin-bottom: 10px;
      color: white;
    }
    
    .subtitle {
      font-size: 1.3rem;
      opacity: 0.9;
      margin-bottom: 15px;
      color: white;
    }
    
    .version {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.2);
      padding: 10px 20px;
      border-radius: 25px;
      font-size: 1rem;
      backdrop-filter: blur(10px);
      color: white;
    }
    
    .content {
      padding: 40px;
    }
    
    .card {
      background: var(--light);
      border-radius: 12px;
      padding: 30px;
      margin-bottom: 25px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      border: 1px solid var(--border);
    }
    
    .card-header {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 25px;
      padding-bottom: 15px;
      border-bottom: 3px solid var(--primary);
    }
    
    .card-header i {
      color: var(--primary);
      font-size: 1.8rem;
    }
    
    .card-title {
      font-size: 1.6rem;
      font-weight: 600;
      color: var(--primary);
      margin: 0;
    }
    
    .form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); /* Reduzido de 320px para 250px */
  gap: 15px; /* Reduzido de 25px para 15px */
  margin-bottom: 25px;
}

    
    .form-group {
      margin-bottom: 25px;
      position: relative;
    }
    
    .form-label {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
      font-weight: 600;
      color: var(--dark);
      font-size: 1.1rem;
    }
    
    .form-label i {
      color: var(--primary);
      width: 20px;
      text-align: center;
    }
    
    .required::after {
      content: " *";
      color: var(--danger);
    }
    
    .form-control {
      width: 100%;
      padding: 14px 16px;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 1.05rem;
      transition: all 0.3s ease;
      background: var(--light);
    }
    
    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(126, 62, 154, 0.1);
    }
    
    .form-control.error {
      border-color: var(--danger);
      box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
    }
    
    .form-control:disabled {
      background-color: #f8f9fa;
      opacity: 0.7;
      cursor: not-allowed;
    }
    
    textarea.form-control {
      min-height: 120px;
      resize: vertical;
      line-height: 1.5;
    }
    
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 14px 28px;
      border: none;
      border-radius: 10px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      min-width: 140px;
      justify-content: center;
    }
    
    .btn-primary {
      background: var(--primary);
      color: white;
    }
    
    .btn-primary:hover {
      background: #6a2e82;
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(126, 62, 154, 0.3);
    }
    
    .btn-secondary {
      background: var(--secondary);
      color: white;
    }
    
    .btn-secondary:hover {
      background: #8fb83a;
      transform: translateY(-2px);
    }
    
    .btn-warning {
      background: var(--warning);
      color: var(--dark);
    }
    
    .btn-warning:hover {
      background: #e0a800;
      transform: translateY(-2px);
    }
    
    .btn-danger {
      background: var(--danger);
      color: white;
    }
    
    .btn-danger:hover {
      background: #c82333;
      transform: translateY(-2px);
    }
    
    .btn-info {
      background: var(--info);
      color: white;
    }
    
    .btn-info:hover {
      background: #138496;
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(23, 162, 184, 0.3);
    }
    
    .btn-success {
      background: var(--success);
      color: white;
    }
    
    .btn-success:hover {
      background: #218838;
      transform: translateY(-2px);
    }
    
    .btn-group {
      display: flex;
      gap: 15px;
      margin-top: 30px;
      flex-wrap: wrap;
    }
    
    .btn-group .btn {
      flex: 1;
      min-width: 200px;
    }
    
    .message {
      padding: 18px 24px;
      border-radius: 10px;
      margin: 20px 0;
      display: none;
      align-items: center;
      gap: 15px;
      font-weight: 600;
      font-size: 1.1rem;
    }
    
    .message i {
      font-size: 1.4rem;
    }
    
    .success {
      background: #d4edda;
      color: var(--success);
      border: 1px solid #c3e6cb;
    }
    
    .error {
      background: #f8d7da;
      color: var(--danger);
      border: 1px solid #f5c6cb;
    }
    
    .info {
      background: #d1ecf1;
      color: #0c5460;
      border: 1px solid #bee5eb;
    }
    
    .loading {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--primary);
    }
    
    .spinner {
      width: 18px;
      height: 18px;
      border: 2px solid #f3f3f3;
      border-top: 2px solid var(--primary);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }
    
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    .loja-exists {
      border-color: var(--warning);
      background: #fffbf0;
    }
    
    .defasagem-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      background: var(--danger);
      color: white;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 600;
      margin-left: 15px;
    }
    
    .search-container {
      position: relative;
    }

    .suggestions {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: white;
      border: 1px solid var(--primary);
      border-top: none;
      border-radius: 0 0 10px 10px;
      z-index: 1000;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      margin-top: -2px;
      max-height: 300px;
      overflow-y: auto;
    }

    .suggestion-item {
      padding: 12px 16px;
      cursor: pointer;
      border-bottom: 1px solid var(--border);
      transition: all 0.2s ease;
      font-size: 1rem;
      font-weight: 500;
    }

    .suggestion-item:hover {
      background: var(--primary);
      color: white;
      font-weight: 600;
    }

    .suggestion-item:last-child {
      border-bottom: none;
    }
    
    .suggestion-section {
      background: var(--primary);
      color: white;
      font-weight: 700;
      padding: 10px 16px;
      font-size: 0.9rem;
      border-bottom: 1px solid var(--border);
    }
    
    .action-buttons {
      display: flex;
      gap: 15px;
      margin-top: 20px;
      flex-wrap: wrap;
    }
    
    .multi-select {
      display: flex;
      flex-wrap: wrap;
      gap: 8px; /* ✅ DIMINUÍDO O ESPAÇAMENTO */
      margin-top: 5px;
    }
    
    .multi-select-option {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 6px 10px; /* ✅ DIMINUÍDO O PADDING */
      background: #f8f9fa;
      border: 1px solid var(--border);
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.3s ease;
      font-size: 0.9rem; /* ✅ DIMINUÍDO A FONTE */
    }
    
    .multi-select-option.selected {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }
    
    .multi-select-option input {
      display: none;
    }
    
    .error-message {
      color: var(--danger);
      font-size: 0.9rem;
      margin-top: 5px;
      display: none;
      font-weight: 500;
    }

    /* ⭐⭐ NOVOS ESTILOS PARA AS SEÇÕES DE LOJAS ⭐⭐ */
    .btn-ver-defasagem {
      background: #FFD700 !important;
      color: #333 !important;
      border: 2px solid #FFC107 !important;
      font-weight: 700 !important;
    }

    .btn-ver-defasagem:hover {
      background: #FFC107 !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 8px 20px rgba(255, 193, 7, 0.3) !important;
    }

    .btn-ver-agendadas {
      background: #20C997 !important;
      color: white !important;
      border: 2px solid #198754 !important;
      font-weight: 700 !important;
    }

    .btn-ver-agendadas:hover {
      background: #198754 !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 8px 20px rgba(25, 135, 84, 0.3) !important;
    }

    .btn-ver-todas {
      background: #7E3E9A !important;
      color: white !important;
      border: 2px solid #6a2e82 !important;
      font-weight: 700 !important;
    }

    .btn-ver-todas:hover {
      background: #6a2e82 !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 8px 20px rgba(126, 62, 154, 0.3) !important;
    }

    /* 🔄 ESTILO ESPECÍFICO APENAS PARA O BOTÃO "VER TODAS AS LOJAS" */
.btn-ver-todas .loading {
    color: white !important;
    font-weight: 600;
}

.btn-ver-todas .spinner {
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top: 2px solid white;
}

    .lojas-container {
      margin-top: 30px;
      padding: 25px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      border: 2px solid var(--primary);
    }

    .lojas-container.defasagem {
      border-color: #FFC107;
    }

    .lojas-container.agendadas {
      border-color: #20C997;
    }

    .lojas-container.todas {
      border-color: #7E3E9A;
    }

    .lojas-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 20px;
  margin-top: 20px;
}


    .loja-card {
      background: white;
      border-radius: 10px;
      padding: 20px;
      border: 2px solid var(--border);
      transition: all 0.3s ease;
      position: relative;
    }

    .loja-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .loja-card.em-andamento {
      border-left: 5px solid var(--warning);
    }

    .loja-card.concluido {
      border-left: 5px solid var(--success);
    }

    .loja-card.nao-concluido {
      border-left: 5px solid var(--danger);
    }

    .loja-card.agendada {
      border-left: 5px solid var(--info);
    }

    .loja-card.todas {
      border-left: 5px solid #7E3E9A;
    }

    .loja-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 15px;
    }

    .loja-nome {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--dark);
      margin-bottom: 5px;
    }

    .loja-status {
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
    }

    .status-em-andamento {
    background: #FFF3CD;  /* AMARELO */
    color: #856404;
}

    .status-concluido {
      background: #D1E7DD;
      color: #0F5132;
    }

.status-nao-concluido {
    background: #F8D7DA;  /* VERMELHO */
    color: #721C24;
}

    .status-agendada {
    background: #CCE7FF;  /* AZUL */
    color: #084298;
}

    .loja-info {
      margin-bottom: 10px;
      font-size: 0.95rem;
    }

    .loja-info strong {
      color: var(--primary);
    }

    .loja-defasagem {
      background: var(--danger);
      color: white;
      padding: 4px 10px;
      border-radius: 15px;
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .loja-agendamento {
      background: var(--info);
      color: white;
      padding: 4px 10px;
      border-radius: 15px;
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .loja-ultimo-evento {
      font-style: italic;
      color: var(--gray);
      font-size: 0.9rem;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid var(--border);
    }

    .data-retorno-info {
      background: #E7F3FF;
      color: #0D6EFD;
      padding: 4px 10px;
      border-radius: 15px;
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .tipo-calculo {
      font-size: 0.75rem;
      color: var(--gray);
      font-style: italic;
      margin-top: 5px;
    }

    /* ⭐⭐ NOVOS ESTILOS PARA OS FILTROS DE PESQUISA ⭐⭐ */
    .filtro-container {
      background: #f8f9fa;
      padding: 20px;
      border-radius: 10px;
      margin-bottom: 20px;
      border: 1px solid var(--border);
    }

    .filtro-header {
      display: flex;
      justify-content: between;
      align-items: center;
      margin-bottom: 15px;
      flex-wrap: wrap;
      gap: 15px;
    }

    .filtro-title {
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--primary);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .filtro-pesquisa {
      display: flex;
      gap: 10px;
      align-items: center;
      flex: 1;
      min-width: 300px;
    }

    .filtro-pesquisa input {
      flex: 1;
      padding: 10px 15px;
      border: 2px solid var(--border);
      border-radius: 8px;
      font-size: 1rem;
    }

    .filtro-pesquisa input:focus {
      outline: none;
      border-color: var(--primary);
    }

    .filtro-ordenacao {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .filtro-ordenacao select {
  padding: 10px 15px;
  border: 2px solid var(--border);
  border-radius: 8px;
  font-size: 1rem;
  background: white;
  cursor: pointer;
  transition: all 0.3s ease;
}

.filtro-ordenacao select:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(126, 62, 154, 0.1);
}

.filtro-ordenacao select option {
  padding: 10px;
  font-size: 1rem;
}

    .contador-lojas {
      background: var(--primary);
      color: white;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 600;
    }

        .contador-lojas {
      background: var(--primary);
      color: white;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 600;
    }

    /* 🔥🔥🔥 COLE O CSS DO MODAL AQUI 🔥🔥🔥 */
    .modal-detalhes {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        z-index: 10000;
        justify-content: center;
        align-items: center;
        animation: fadeIn 0.3s ease;
    }

    .modal-detalhes-content {
        background: white;
        padding: 30px;
        border-radius: 15px;
        max-width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        width: 800px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        position: relative;
        animation: slideUp 0.3s ease;
    }

    .modal-detalhes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 3px solid var(--primary);
    }

    .modal-detalhes-title {
        color: var(--primary);
        margin: 0;
        font-size: 1.8rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-fechar-modal {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: var(--danger);
        padding: 5px;
        border-radius: 50%;
        transition: all 0.3s ease;
    }

    .btn-fechar-modal:hover {
        background: var(--danger);
        color: white;
        transform: rotate(90deg);
    }

    .detalhes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .detalhe-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 4px solid var(--primary);
    }

    .detalhe-label {
        font-weight: 600;
        color: var(--dark);
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detalhe-valor {
        color: var(--gray);
        font-size: 1rem;
        word-break: break-word;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-novo {
        background: #E7F3FF;
        color: #0D6EFD;
    }

    .status-andamento {
        background: #FFF3CD;
        color: #856404;
    }

    .status-concluido {
        background: #D1E7DD;
        color: #0F5132;
    }

    .status-cancelado {
        background: #F8D7DA;
        color: #721C24;
    }

    .modal-detalhes-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes slideUp {
        from { 
            opacity: 0;
            transform: translateY(30px);
        }
        to { 
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    
@media (max-width: 768px) {
  .form-grid {
    grid-template-columns: 1fr;
    gap: 10px;
  }
}
  .form-grid {
    grid-template-columns: 1fr;
  }
  
  .btn-group {
    flex-direction: column;
  }
  
  .header {
    padding: 20px;
  }
  
  h1 {
    font-size: 2.2rem;
  }
  
  .logo {
    width: 80px;
    height: 80px;
  }

  .lojas-grid {
    grid-template-columns: 1fr;
  }

  .action-buttons {
    flex-direction: column;
  }

  .filtro-header {
    flex-direction: column;
    align-items: stretch;
  }

  .filtro-pesquisa {
    min-width: auto;
  }
} /* 🔥 IMPORTANTE: FECHAR A CHAVE AQUI */
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
