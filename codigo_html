function validarAdesao() {
  const adesao = document.getElementById('adesao');
  const formaPagamento = document.getElementById('forma_pagamento');
  const parcelas = document.getElementById('parcelas');
  const dataPagamentoAdesao = document.getElementById('data_pagamento_adesao');
  const labelDataPagamento = document.getElementById('label-data-pagamento-adesao');
  
  const adesaoValor = parseInt(adesao.value);
  
  console.log("💰 Validando adesão - Valor:", adesaoValor);
  
  if (adesaoValor === 0) {
    // ✅ ADESÃO = R$ 0,00
    formaPagamento.value = 'ISENTO';
    parcelas.value = 'ISENTO';
    
    // BLOQUEAR CAMPOS
    formaPagamento.disabled = true;
    parcelas.disabled = true;
    dataPagamentoAdesao.disabled = true;
    
    // REMOVER OBRIGATORIEDADE E ERROS
    labelDataPagamento.classList.remove('required');
    dataPagamentoAdesao.required = false;
    
    // REMOVER MENSAGENS DE ERRO
    document.getElementById('erro-data_pagamento_adesao').style.display = 'none';
    document.getElementById('erro-forma_pagamento').style.display = 'none'; 
    document.getElementById('erro-parcelas').style.display = 'none';
    
