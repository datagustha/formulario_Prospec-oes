    function formatarData(data) {
        if (!data || data === 'N/A') return 'N/A';
        if (data instanceof Date) return data.toLocaleDateString('pt-BR');
        
        // Se for string no formato YYYY-MM-DD
        if (data.match(/^\d{4}-\d{2}-\d{2}$/)) {
            const partes = data.split('-');
            return `${partes[2]}/${partes[1]}/${partes[0]}`;
        }
        
        return data;
    }


// 🔥🔥🔥 FUNÇÕES AUXILIARES PARA FORMATAÇÃO 🔥🔥🔥
function formatarMoedaParaExibicao(valor) {
    if (!valor || valor === 0 || valor === '0') return 'R$ 0,00';
    
    const numero = parseFloat(valor);
    if (isNaN(numero)) return 'R$ 0,00';
    
    return numero.toLocaleString('pt-BR', {
        style: 'currency',
        currency: 'BRL'
    });
}

// 🔥🔥🔥 ADICIONAR ESTA FUNÇÃO SE AINDA NÃO EXISTIR - NORMALIZAR NO FRONTEND
function normalizarNoFrontend(texto) {
  if (!texto || typeof texto !== 'string') return texto;
  
  // 🔥 NÃO normalizar se for número, data, ou campo monetário
  if (!isNaN(texto)) return texto; // Números
  if (texto.includes('R$')) return texto; // Valores monetários
  if (texto.match(/\d{2}\/\d{2}\/\d{4}/)) return texto; // Datas DD/MM/AAAA
  
  return texto
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '') // Remove acentos
    .toUpperCase()
    .trim();
}

function formatarPercentualParaExibicao(percentual) {
    if (!percentual || percentual === '0%') return '';
    
    if (typeof percentual === 'string' && percentual.includes('%')) {
        return percentual;
    }
    
    const numero = parseFloat(percentual);
    if (isNaN(numero)) return '';
    
    return `(${numero}%)`;
}

function formatarDataParaExibicao(data) {
    if (!data) return 'N/A';
    
    if (data instanceof Date) {
        return data.toLocaleDateString('pt-BR');
    }
    
    if (typeof data === 'string') {
        // Tentar converter string para data
        const dataObj = new Date(data);
        if (!isNaN(dataObj.getTime())) {
            return dataObj.toLocaleDateString('pt-BR');
        }
        return data; // Retorna a string original se não for uma data válida
    }
    
    return 'N/A';
}

function getSituacaoClass(situacao) {
    if (!situacao) return 'status-novo';
    
    const situacaoLower = situacao.toLowerCase();
    
    if (situacaoLower.includes('novo')) return 'status-novo';
    if (situacaoLower.includes('andamento')) return 'status-andamento';
    if (situacaoLower.includes('concluído') || situacaoLower.includes('concluido')) return 'status-concluido';
    if (situacaoLower.includes('cancelado') || situacaoLower.includes('cancelada')) return 'status-cancelado';
    
    return 'status-novo';
}

