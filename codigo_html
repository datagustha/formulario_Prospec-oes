      <!-- ⭐⭐ SEÇÃO DE LOJAS CADASTRADAS ⭐⭐ -->
      <div class="lojas-container" id="secaoLojas" style="display: none;">
        <div class="card-header">
          <i class="fas fa-store"></i>
          <h2 class="card-title">Lojas com Defasagem</h2>
        </div>
        <div class="lojas-grid" id="gridLojas">
          <!-- As lojas serão carregadas aqui dinamicamente -->
        </div>
      </div>
      
      <div class="btn-group">
        <button type="button" class="btn btn-primary" onclick="cadastrarLoja()" id="btnCadastrar">
          <i class="fas fa-plus-circle"></i>
          Cadastrar Loja
        </button>
        <button type="button" class="btn btn-warning" onclick="atualizarRegistro()" id="btnAtualizar" style="display: none;">
          <i class="fas fa-save"></i>
          Atualizar Registro
        </button>
      </div>
      
      <div id="messageSuccess" class="message success" style="display: none;">
        <i class="fas fa-check-circle"></i>
        <span></span>
      </div>
      
      <div id="messageError" class="message error" style="display: none;">
        <i class="fas fa-exclamation-circle"></i>
        <span></span>
      </div>
      
      <div id="messageInfo" class="message info" style="display: none;">
        <i class="fas fa-info-circle"></i>
        <span></span>
      </div>
