/**************************
 * FUNÇÕES DE EVENTOS *
 **************************/

function identificarMudancas(antigos, novos) {
  const mudancas = [];
  
  console.log("🔍 COMPARANDO MUDANÇAS:");
  console.log("Status:", antigos[16], "→", novos[16]);
  console.log("Evento:", antigos[17], "→", novos[17]);
  console.log("Data Retorno:", antigos[15], "→", novos[15]);
  console.log("Observação:", antigos[20], "→", novos[20]);
  
  if (String(antigos[16]) !== String(novos[16])) {
    mudancas.push(`Status: ${antigos[16]} → ${novos[16]}`);
  }
  
  if (String(antigos[17]) !== String(novos[17])) {
    mudancas.push(`Evento: ${antigos[17]} → ${novos[17]}`);
  }
  
  if (String(antigos[15] || '') !== String(novos[15] || '')) {
    mudancas.push(`Data retorno: ${antigos[15] || 'N/A'} → ${novos[15] || 'N/A'}`);
  }
  
  if (String(antigos[20] || '') !== String(novos[20] || '')) {
    mudancas.push(`Observação atualizada`);
  }
  
  console.log("Mudanças encontradas:", mudancas);
  return mudancas.length > 0 ? mudancas.join(' | ') : 'Dados mantidos';
}

function registrarEventoCompleto(dados, dataHoraAtual, mudancas) {
  try {
    console.log("📝 Registrando evento - Mudanças:", mudancas);
    
    const ss = SpreadsheetApp.openById(ID_PLANILHA_PROSPECCOES);
    const abaEventos = ss.getSheetByName(ABA_EVENTOS);
    
    if (!abaEventos) {
      console.log("❌ Aba de eventos não encontrada");
      return null;
    }

    const ultimaLinha = abaEventos.getLastRow();
    let proximoIDEvento = 1;
    
    if (ultimaLinha > 3) {
      const ids = abaEventos.getRange(4, 1, ultimaLinha - 3, 1).getValues().flat();
      const numerosIds = ids.filter(id => id !== '' && !isNaN(id)).map(Number);
      if (numerosIds.length > 0) proximoIDEvento = Math.max(...numerosIds) + 1;
    }

    // 🔥 ESTRUTURA ATUALIZADA COM 21 COLUNAS
    const linhaEvento = [
      proximoIDEvento,                                    // A - ID
      dataHoraAtual,                                      // B - Data registro
      dados.loja,                                        // C - Loja
      dados.segmento,                                    // D - Segmento
      dados.telefone,                                    // E - Telefone
      dados.fornecedor,                                  // F - Fornecedor
      dados.trafego,                                     // G - Tráfego
      parseInt(dados.quantidade_lojas) || 1,             // H - Quantidade de lojas
      parseFloat(dados.adesao) || 0,                     // I - Adesão
      dados.data_pagamento_adesao ? new Date(dados.data_pagamento_adesao) : '', // J
      dados.forma_pagamento,                             // K - Forma de pagamento
      dados.parcelas,                                    // L - Parcelas
      converterMoedaParaNumero(dados.plano_assinatura),  // M - Plano de assinatura
      dados.usuario,                                     // N - Usuário
      dados.representante || '',                         // O - Representante / Comercial Interno
      dados.data_retorno_cliente ? new Date(dados.data_retorno_cliente) : '', // P - Data retorno cliente
      dados.status,                                      // Q - Status
      dados.evento,                                      // R - Evento
      dataHoraAtual,                                     // S - Data último evento
      "0 dias",                                          // T - Defasagem
      mudancas + (dados.observacao ? ` | ${dados.observacao}` : '') // U - Observação
    ];

    const linhaInserir = Math.max(4, ultimaLinha + 1);
    abaEventos.getRange(linhaInserir, 1, 1, linhaEvento.length).setValues([linhaEvento]);
    
    // 🔥 FORMATAÇÃO CORRETA
    abaEventos.getRange(linhaInserir, 2).setNumberFormat('dd/mm/yyyy hh:mm'); // Data registro
    abaEventos.getRange(linhaInserir, 9).setNumberFormat('"R$"#,##0.00'); // Adesão
    abaEventos.getRange(linhaInserir, 13).setNumberFormat('"R$"#,##0.00'); // Plano
    abaEventos.getRange(linhaInserir, 19).setNumberFormat('dd/mm/yyyy hh:mm'); // Data último evento
    if (dados.data_retorno_cliente) {
      abaEventos.getRange(linhaInserir, 16).setNumberFormat('dd/mm/yyyy'); // Data retorno cliente
    }

    console.log("✅ Evento registrado CORRETAMENTE - ID:", proximoIDEvento);
    return proximoIDEvento;

  } catch (error) {
    console.log("❌ Erro registrarEventoCompleto:", error);
    return null;
  }
}

