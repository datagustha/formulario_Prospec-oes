function buscarLojasAgendadas() {
  try {
    console.log("📅 Buscando lojas com data na coluna P...");
    
    const ss = SpreadsheetApp.openById(ID_PLANILHA_PROSPECCOES);
    const aba = ss.getSheetByName(ABA_PRINCIPAL);
    
    if (!aba) return [];
    
    const ultimaLinha = aba.getLastRow();
    if (ultimaLinha < 4) return [];
    
    const dados = aba.getRange(4, 1, ultimaLinha - 3, 21).getValues();
    const lojasAgendadas = [];
    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0);

    for (let i = 0; i < dados.length; i++) {
      const linha = dados[i];
      const nomeLoja = linha[2];
      const dataRetornoCliente = linha[15];
      
      // ⭐⭐ CONDIÇÃO SIMPLES: TEM NOME E TEM DATA ⭐⭐
      if (nomeLoja && nomeLoja.toString().trim() !== '' && 
          dataRetornoCliente && dataRetornoCliente instanceof Date && 
          !isNaN(dataRetornoCliente.getTime())) {
        
        const dataRetorno = new Date(dataRetornoCliente);
        dataRetorno.setHours(0, 0, 0, 0);
        
        // ⭐⭐ CÁLCULO SIMPLES: dias desde a data agendada até hoje ⭐⭐
        const diffMs = hoje - dataRetorno;
        const diasDefasagem = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        
        const loja = {
          id: linha[0] || '',
          loja: nomeLoja.toString().trim(),
          segmento: linha[3] || '',
          telefone: linha[4] || '',
          fornecedor: linha[5] || '',
          trafego: linha[6] || '',
          quantidade_lojas: linha[7] || '',
          adesao: linha[8] || 0,
          usuario: linha[13] || '',
          representante: linha[14] || '',
          data_retorno_cliente: formatarData(dataRetornoCliente),
          status: linha[16] || 'Em andamento',
          evento: linha[17] || '',
          data_ultimo_evento: linha[18] ? formatarData(linha[18]) : '',
          defasagem: diasDefasagem, // ⭐⭐ AGORA É DEFASAGEM MESMO ⭐⭐
          observacao: linha[20] || ''
        };
        
        lojasAgendadas.push(loja);
      }
    }

    // ⭐⭐ ORDENAR: DATA MAIS ANTIGA PRIMEIRO ⭐⭐
    lojasAgendadas.sort((a, b) => {
      const dataA = new Date(a.data_retorno_cliente.split('/').reverse().join('-'));
      const dataB = new Date(b.data_retorno_cliente.split('/').reverse().join('-'));
      return dataA - dataB;
    });

    console.log("✅ Lojas agendadas encontradas:", lojasAgendadas.length);
    return lojasAgendadas;

  } catch (error) {
    console.log("❌ Erro em buscarLojasAgendadas:", error);
    return [];
  }
}

