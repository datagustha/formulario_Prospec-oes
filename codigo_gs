function buscarTodasLojas() {
  try {
    const ss = SpreadsheetApp.openById(ID_PLANILHA_PROSPECCOES);
    const aba = ss.getSheetByName(ABA_PRINCIPAL);
    if (!aba) return [];

    const ultimaLinha = aba.getLastRow();
    if (ultimaLinha < 4) return [];

    const valores = aba.getRange(4, 3, ultimaLinha - 3, 1).getValues();
    const setLojas = new Set();

    for (let i = 0; i < valores.length; i++) {
      const v = valores[i][0];
      if (v !== null && v !== undefined && v !== '') {
        const s = String(v).trim();
        if (s !== '') setLojas.add(s);
      }
    }

    const lojasArray = Array.from(setLojas).sort((a, b) => a.localeCompare(b, 'pt-BR'));
    console.log("Lojas carregadas:", lojasArray.length);
    return lojasArray;

  } catch (error) {
    console.log("Erro buscarTodasLojas:", error);
    return [];
  }
}

function formatarDefasagem(dias) {
  if (dias === 0) return "0 dias";
  if (dias === 1) return "1 dia";
  if (dias > 1) return `${dias} dias`;
  return "";
}

function buscarDadosLoja(nomeLoja) {
  try {
    console.log("🔍 Buscando loja:", nomeLoja);
    
    if (!nomeLoja) {
      return { encontrado: false, mensagem: "Nome da loja inválido" };
    }

    const ss = SpreadsheetApp.openById(ID_PLANILHA_PROSPECCOES);
    const aba = ss.getSheetByName(ABA_PRINCIPAL);
    
    if (!aba) {
      return { encontrado: false, mensagem: "Planilha não encontrada" };
    }

    const ultimaLinha = aba.getLastRow();
    if (ultimaLinha < 4) {
      return { encontrado: false, mensagem: "Nenhum dado encontrado" };
    }

    const dados = aba.getRange(4, 1, ultimaLinha - 3, 21).getValues(); // ⬅️ AGORA 21 COLUNAS
    const lojaBuscada = nomeLoja.toString().toLowerCase().trim();

    for (let i = 0; i < dados.length; i++) {
      const linha = dados[i];
      const nomeDaLoja = linha[2] ? linha[2].toString().toLowerCase().trim() : '';
      
      if (nomeDaLoja === lojaBuscada || nomeDaLoja.includes(lojaBuscada)) {
        console.log("✅ Loja encontrada na linha", i + 4);
        
        // ⬇️ CÁLCULO DA DEFASAGEM - COLUNA S (índice 18)
        let defasagemDias = 0;
        const dataUltimoEvento = linha[18]; // Coluna S - Data último evento
        
        if (dataUltimoEvento && dataUltimoEvento instanceof Date && !isNaN(dataUltimoEvento.getTime())) {
          const hoje = new Date();
          const dataEvento = new Date(dataUltimoEvento);
          dataEvento.setHours(0, 0, 0, 0);
          const hojeZerado = new Date(hoje);
          hojeZerado.setHours(0, 0, 0, 0);
          
          const diffMs = hojeZerado - dataEvento;
          defasagemDias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        } else {
          defasagemDias = 999;
        }

        // ⬇️ FORMATAR DEFASAGEM COM "DIAS"
        const defasagemFormatada = formatarDefasagem(defasagemDias);

        // ⬇️ CORREÇÃO: ADESÃO COMO NÚMERO PARA O SELECT
        const adesaoValor = linha[8] || 0;
        const adesaoParaSelect = parseFloat(adesaoValor) || 0;

        return {
          encontrado: true,
          id: linha[0] || '',
          loja: linha[2] || '',
          segmento: linha[3] || '',
          telefone: linha[4] || '',
          fornecedor: linha[5] || '',
          trafego: linha[6] || '',
          quantidade_lojas: linha[7] || '',
          adesao: adesaoParaSelect,
          data_pagamento_adesao: linha[9] ? formatarData(linha[9]) : '',
          forma_pagamento: linha[10] || '',
          parcelas: linha[11] || '',
          plano_assinatura: linha[12] ? formatarMoeda(linha[12]) : '',
          usuario: linha[13] || '',
          representante: linha[14] || '', // ⬅️ COLUNA O
          data_retorno_cliente: linha[15] ? formatarData(linha[15]) : '', // ⬅️ COLUNA P
          status: linha[16] || 'Em andamento', // ⬅️ COLUNA Q
          evento: linha[17] || '', // ⬅️ COLUNA R
          data_ultimo_evento: dataUltimoEvento ? formatarData(dataUltimoEvento) : '', // ⬅️ COLUNA S
          defasagem: defasagemFormatada, // ⬅️ COLUNA T
          observacao: linha[20] || '' // ⬅️ COLUNA U
        };
      }
    }

    console.log("❌ Loja não encontrada");
    return { 
      encontrado: false, 
      mensagem: "Loja não encontrada na base de dados" 
    };

  } catch (error) {
    console.log("❌ Erro buscarDadosLoja:", error);
    return { 
      encontrado: false, 
      mensagem: "Erro: " + error.message 
    };
  }
}

