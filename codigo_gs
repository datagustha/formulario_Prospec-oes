// ⭐⭐ FUNÇÕES DE ATUALIZAÇÃO DE DEFASAGEM (MANTIDAS) ⭐⭐
function atualizarTodasDefasagens() {
  try {
    console.log("🔄 Atualizando defasagens de todas as lojas...");
    
    const ss = SpreadsheetApp.openById(ID_PLANILHA_PROSPECCOES);
    const aba = ss.getSheetByName(ABA_PRINCIPAL);
    
    if (!aba) {
      console.log("❌ Aba não encontrada");
      return;
    }

    const ultimaLinha = aba.getLastRow();
    if (ultimaLinha < 4) {
      console.log("📝 Nenhum dado para atualizar");
      return;
    }

    const dados = aba.getRange(4, 1, ultimaLinha - 3, 21).getValues();
    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0);
    
    let atualizacoes = 0;

    for (let i = 0; i < dados.length; i++) {
      const linha = dados[i];
      const dataUltimoEvento = linha[18]; // Coluna S
      
      let defasagemDias = 0;
      
      if (dataUltimoEvento && dataUltimoEvento instanceof Date && !isNaN(dataUltimoEvento.getTime())) {
        const dataEvento = new Date(dataUltimoEvento);
        dataEvento.setHours(0, 0, 0, 0);
        
        const diffMs = hoje - dataEvento;
        defasagemDias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        
        const defasagemFormatada = formatarDefasagem(defasagemDias);
        if (linha[19] !== defasagemFormatada) {
          aba.getRange(i + 4, 20).setValue(defasagemFormatada); // Coluna T - Defasagem
          atualizacoes++;
        }
      } else {
        const defasagemMaxima = formatarDefasagem(999);
        if (linha[19] !== defasagemMaxima) {
          aba.getRange(i + 4, 20).setValue(defasagemMaxima);
          atualizacoes++;
        }
      }
    }
    
    console.log("✅ Defasagens atualizadas:", atualizacoes, "registros");
    return { success: true, message: `✅ ${atualizacoes} defasagens atualizadas` };
    
  } catch (error) {
    console.log("❌ Erro ao atualizar defasagens:", error);
    return { success: false, message: "Erro: " + error.message };
  }
}

// ⭐⭐ FUNÇÃO: ATUALIZAR DEFASAGENS MANUALMENTE ⭐⭐
function atualizarDefasagensManual() {
  try {
    console.log("🔧 FORÇANDO atualização de defasagens...");
    const resultado = atualizarTodasDefasagens();
    
    if (resultado && resultado.success) {
      console.log("✅ Defasagens atualizadas com sucesso!");
      return { 
        success: true, 
        message: "✅ Defasagens atualizadas com sucesso! " + resultado.message 
      };
    } else {
      return { 
        success: false, 
        message: "❌ Erro ao atualizar defasagens: " + (resultado?.message || "Erro desconhecido") 
      };
    }
  } catch (error) {
    console.log("❌ Erro crítico:", error);
    return { 
      success: false, 
      message: "❌ Erro: " + error.message 
    };
  }
}

