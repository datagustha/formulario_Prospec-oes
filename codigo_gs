      const ids = aba.getRange(4, 1, ultimaLinha - 3, 1).getValues().flat();
      const numerosIds = ids.filter(id => id !== '' && !isNaN(id)).map(Number);
      if (numerosIds.length > 0) proximoID = Math.max(...numerosIds) + 1;
    }

    const adesaoNumero = parseFloat(dados.adesao) || 0;
    const planoAssinaturaNumero = converterMoedaParaNumero(dados.plano_assinatura);

    // 🔥 CORREÇÃO: DEFINIR STATUS E EVENTO PADRÃO EXPLICITAMENTE
