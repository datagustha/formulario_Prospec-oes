function cadastrarNovaLoja(aba, dados, dataHoraAtual) {
  try {
    console.log("➕ Cadastrando nova loja:", dados.loja);

    // Verificar duplicidade
    const lojasExistentes = buscarTodasLojas();
    if (lojasExistentes.includes(dados.loja)) {
      return { success: false, message: "❌ Esta loja já está cadastrada!" };
    }

    const ultimaLinha = aba.getLastRow();
    let proximoID = 1;
    
    if (ultimaLinha >= 4) {
      const ids = aba.getRange(4, 1, ultimaLinha - 3, 1).getValues().flat();
      const numerosIds = ids.filter(id => id !== '' && !isNaN(id)).map(Number);
      if (numerosIds.length > 0) proximoID = Math.max(...numerosIds) + 1;
    }

    // ⬇️ CORREÇÃO: Converter adesão para número ⬇️
    const adesaoNumero = parseFloat(dados.adesao) || 0;
    const planoAssinaturaNumero = converterMoedaParaNumero(dados.plano_assinatura);

    const linhaDados = [
      proximoID,
      dataHoraAtual,
      dados.loja,
      dados.segmento,
      dados.telefone,
      dados.fornecedor,
      dados.trafego,
      parseInt(dados.quantidade_lojas) || 1,
      adesaoNumero, // ⬅️ AGORA É NÚMERO
      dados.data_pagamento_adesao ? new Date(dados.data_pagamento_adesao) : '',
      dados.forma_pagamento,
      dados.parcelas,
      planoAssinaturaNumero,
      dados.usuario,
      dados.representante || '',
      'Em andamento',
      'Cadastro inicial',
      dataHoraAtual,
      "0 dias",
      'Loja cadastrada no sistema'
    ];

    const linhaInserir = ultimaLinha + 1;
    aba.getRange(linhaInserir, 1, 1, linhaDados.length).setValues([linhaDados]);

    // ⬇️ CORREÇÃO: Formatar adesão como moeda ⬇️
    aba.getRange(linhaInserir, 9).setNumberFormat('"R$"#,##0.00'); // Adesão
    aba.getRange(linhaInserir, 13).setNumberFormat('"R$"#,##0.00'); // Plano
    aba.getRange(linhaInserir, 2).setNumberFormat('dd/mm/yyyy hh:mm'); // Data registro
    aba.getRange(linhaInserir, 18).setNumberFormat('dd/mm/yyyy hh:mm'); // Data último evento

    // Registrar evento
    registrarEventoCompleto({
      ...dados,
      id: proximoID,
      status: 'Em andamento',
      evento: 'Cadastro inicial',
      observacao: 'Loja cadastrada no sistema'
    }, dataHoraAtual, "Cadastro inicial");

    console.log("✅ Loja cadastrada - ID:", proximoID);
    return { 
      success: true, 
      message: `✅ Loja "${dados.loja}" cadastrada com sucesso! ID: ${proximoID}` 
    };

  } catch (error) {
    console.log("❌ Erro cadastrarNovaLoja:", error);
    return { success: false, message: "Erro ao cadastrar: " + error.message };
  }
}
