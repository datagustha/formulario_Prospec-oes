function buscarTodasLojas() {
  try {
    const ss = SpreadsheetApp.openById(ID_PLANILHA_PROSPECCOES);
    const aba = ss.getSheetByName(ABA_PRINCIPAL);
    if (!aba) return [];

    const ultimaLinha = aba.getLastRow();
    if (ultimaLinha < 4) return [];

    const valores = aba.getRange(4, 3, ultimaLinha - 3, 1).getValues();
    const setLojas = new Set();

    for (let i = 0; i < valores.length; i++) {
      const v = valores[i][0];
      if (v !== null && v !== undefined && v !== '') {
        const s = String(v).trim();
        if (s !== '') setLojas.add(s);
      }
    }

    const lojasArray = Array.from(setLojas).sort((a, b) => a.localeCompare(b, 'pt-BR'));
    console.log("Lojas carregadas:", lojasArray.length);
    return lojasArray;

  } catch (error) {
    console.log("Erro buscarTodasLojas:", error);
    return [];
  }
}

// ⬇️ CORREÇÃO: Função auxiliar para formatar defasagem com "dias"
function formatarDefasagem(dias) {
  if (dias === 0) return "0 dias";
  if (dias === 1) return "1 dia";
  if (dias > 1) return `${dias} dias`;
  return ""; // Para valores inválidos
}

function buscarDadosLoja(nomeLoja) {
  try {
    console.log("🔍 Buscando loja:", nomeLoja);
    
    if (!nomeLoja) {
      return { encontrado: false, mensagem: "Nome da loja inválido" };
    }

    const ss = SpreadsheetApp.openById(ID_PLANILHA_PROSPECCOES);
    const aba = ss.getSheetByName(ABA_PRINCIPAL);
    
    if (!aba) {
      return { encontrado: false, mensagem: "Planilha não encontrada" };
    }

    const ultimaLinha = aba.getLastRow();
    if (ultimaLinha < 4) {
      return { encontrado: false, mensagem: "Nenhum dado encontrado" };
    }

    const dados = aba.getRange(4, 1, ultimaLinha - 3, 20).getValues();
    const lojaBuscada = nomeLoja.toString().toLowerCase().trim();

    for (let i = 0; i < dados.length; i++) {
      const linha = dados[i];
      const nomeDaLoja = linha[2] ? linha[2].toString().toLowerCase().trim() : '';
      
      if (nomeDaLoja === lojaBuscada || nomeDaLoja.includes(lojaBuscada)) {
        console.log("✅ Loja encontrada na linha", i + 4);
        
        // ⬇️ CORREÇÃO: CÁLCULO AUTOMÁTICO DA DEFASAGEM COM "DIAS" ⬇️
        let defasagemDias = 0;
        const dataUltimoEvento = linha[17]; // Coluna R - Data último evento
        
        if (dataUltimoEvento && dataUltimoEvento instanceof Date && !isNaN(dataUltimoEvento.getTime())) {
          const hoje = new Date();
          // Zera as horas para comparar apenas as datas
          const dataEvento = new Date(dataUltimoEvento);
          dataEvento.setHours(0, 0, 0, 0);
          const hojeZerado = new Date(hoje);
          hojeZerado.setHours(0, 0, 0, 0);
          
          const diffMs = hojeZerado - dataEvento;
          defasagemDias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
          
          console.log("📅 Data último evento:", dataEvento);
          console.log("📅 Hoje:", hojeZerado);
          console.log("📊 Defasagem calculada:", defasagemDias, "dias");
        } else {
          console.log("📅 Data último evento inválida ou vazia");
          // Se não tem data, considera defasagem máxima
          defasagemDias = 999;
        }

        // ⬇️ CORREÇÃO: FORMATAR DEFASAGEM COM "DIAS" ⬇️
        let defasagemFormatada = "";
        if (defasagemDias === 0) {
          defasagemFormatada = "0 dias";
        } else if (defasagemDias === 1) {
          defasagemFormatada = "1 dia";
        } else if (defasagemDias > 1) {
          defasagemFormatada = defasagemDias + " dias";
        } else {
          defasagemFormatada = "999 dias";
        }

        // ⬇️ CORREÇÃO: ADESÃO COMO NÚMERO PARA O SELECT ⬇️
        const adesaoValor = linha[8] || 0;
        const adesaoParaSelect = parseFloat(adesaoValor) || 0;

        return {
          encontrado: true,
          id: linha[0] || '',
          loja: linha[2] || '',
          segmento: linha[3] || '',
          telefone: linha[4] || '',
          fornecedor: linha[5] || '',
          trafego: linha[6] || '',
          quantidade_lojas: linha[7] || '',
          adesao: adesaoParaSelect,
          data_pagamento_adesao: linha[9] ? formatarData(linha[9]) : '',
          forma_pagamento: linha[10] || '',
          parcelas: linha[11] || '',
          plano_assinatura: linha[12] ? formatarMoeda(linha[12]) : '',
          usuario: linha[13] || '',
          representante: linha[14] || '',
          status: linha[15] || 'Em andamento',
          evento: linha[16] || '',
          data_ultimo_evento: dataUltimoEvento ? formatarData(dataUltimoEvento) : '',
          defasagem: defasagemFormatada, // ⬅️ AGORA COM "DIAS"
          observacao: linha[19] || ''
        };
      }
    }

    console.log("❌ Loja não encontrada");
    return { 
      encontrado: false, 
      mensagem: "Loja não encontrada na base de dados" 
    };

  } catch (error) {
    console.log("❌ Erro buscarDadosLoja:", error);
    return { 
      encontrado: false, 
      mensagem: "Erro: " + error.message 
    };
  }
}

function atualizarTodasDefasagens() {
  try {
    console.log("🔄 Atualizando defasagens de todas as lojas...");
    
    const ss = SpreadsheetApp.openById(ID_PLANILHA_PROSPECCOES);
    const aba = ss.getSheetByName(ABA_PRINCIPAL);
    
    if (!aba) {
      console.log("❌ Aba não encontrada");
      return;
    }

    const ultimaLinha = aba.getLastRow();
    if (ultimaLinha < 4) {
      console.log("📝 Nenhum dado para atualizar");
      return;
    }

    const dados = aba.getRange(4, 1, ultimaLinha - 3, 20).getValues();
    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0);
    
    let atualizacoes = 0;

    for (let i = 0; i < dados.length; i++) {
      const linha = dados[i];
      const dataUltimoEvento = linha[17]; // Coluna R
      
      let defasagemDias = 0;
      
      if (dataUltimoEvento && dataUltimoEvento instanceof Date && !isNaN(dataUltimoEvento.getTime())) {
        const dataEvento = new Date(dataUltimoEvento);
        dataEvento.setHours(0, 0, 0, 0);
        
        const diffMs = hoje - dataEvento;
        defasagemDias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        
        // ⬇️ CORREÇÃO: USAR A FUNÇÃO formatarDefasagem ⬇️
        const defasagemFormatada = formatarDefasagem(defasagemDias);
        if (linha[18] !== defasagemFormatada) {
          aba.getRange(i + 4, 19).setValue(defasagemFormatada); // Coluna S - Defasagem
          atualizacoes++;
        }
      } else {
        // ⬇️ CORREÇÃO: USAR A FUNÇÃO formatarDefasagem ⬇️
        const defasagemMaxima = formatarDefasagem(999);
        if (linha[18] !== defasagemMaxima) {
          aba.getRange(i + 4, 19).setValue(defasagemMaxima);
          atualizacoes++;
        }
      }
    }
    
    console.log("✅ Defasagens atualizadas:", atualizacoes, "registros");
    return { success: true, message: `✅ ${atualizacoes} defasagens atualizadas` };
    
  } catch (error) {
    console.log("❌ Erro ao atualizar defasagens:", error);
    return { success: false, message: "Erro: " + error.message };
  }
}
function criarTriggerMeiaNoite() {
  try {
    // Remove triggers existentes
    const triggers = ScriptApp.getProjectTriggers();
    triggers.forEach(trigger => ScriptApp.deleteTrigger(trigger));
    
    // Cria trigger para rodar EXATAMENTE À MEIA-NOITE
    ScriptApp.newTrigger('atualizarTodasDefasagens')
      .timeBased()
      .everyDays(1)
      .atHour(0)
      .nearMinute(0)  // ⬅️ Minuto 0 = em ponto
      .create();
    
    console.log("✅ Trigger diário criado para atualizar defasagens às 00:00 em ponto");
    return { success: true, message: "✅ Trigger configurado para rodar às 00:00 em ponto" };
    
  } catch (error) {
    console.log("❌ Erro ao criar trigger:", error);
    return { success: false, message: "Erro: " + error.message };
  }
}
