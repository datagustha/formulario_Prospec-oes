function log(msg, obj) {
  if (obj !== undefined) {
    Logger.log(msg + " %s", JSON.stringify(obj));
  } else {
    Logger.log(msg);
  }
}

function formatarDataHora(data) {
  if (!data) return '';
  const d = new Date(data);
  if (isNaN(d.getTime())) return data.toString();
  const dia = String(d.getDate()).padStart(2, '0');
  const mes = String(d.getMonth() + 1).padStart(2, '0');
  const ano = d.getFullYear();
  const hora = String(d.getHours()).padStart(2, '0');
  const min = String(d.getMinutes()).padStart(2, '0');
  return `${dia}/${mes}/${ano} ${hora}:${min}`;
}

function formatarData(data) {
  if (!data) return '';
  if (data instanceof Date && !isNaN(data.getTime())) {
    const d = data;
    const dia = String(d.getDate()).padStart(2, '0');
    const mes = String(d.getMonth() + 1).padStart(2, '0');
    const ano = d.getFullYear();
    return `${dia}/${mes}/${ano}`;
  }
  return data.toString();
}

function formatarMoeda(valor) {
  if (valor === null || valor === undefined || valor === '') return 'R$ 0,00';
  const numero = typeof valor === 'number' ? valor : parseFloat(String(valor).replace(/[^\d,-]/g, '').replace(',', '.')) || 0;
  return numero.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
}

function converterMoedaParaNumero(valor) {
  if (valor === null || valor === undefined || valor === '') return 0;
  if (typeof valor === 'number') return valor;
  const s = valor.toString().replace(/\s/g, '').replace('R$', '').replace(/\./g, '').replace(',', '.');
  const n = parseFloat(s);
  return isNaN(n) ? 0 : n;
}

// 🔥 ADICIONAR ESTA FUNÇÃO - FALTANDO NO SEU GS
function normalizarTexto(texto) {
  if (!texto || typeof texto !== 'string') return texto;
  
  return texto
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '') // Remove acentos
    .toUpperCase()
    .trim();
}

// 🔥 CORREÇÃO DO FUSO HORÁRIO - ADICIONAR ESTA FUNÇÃO
function corrigirFusoHorario(data) {
  if (!data || !(data instanceof Date) || isNaN(data.getTime())) return data;
  
  // Adiciona 3 horas para corrigir o fuso horário do Brasil (UTC-3)
  const dataCorrigida = new Date(data.getTime() + (3 * 60 * 60 * 1000));
  return dataCorrigida;
}

