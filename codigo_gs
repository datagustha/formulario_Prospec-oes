function buscarTodasLojasCompletas() {
  try {
    console.log("🏪 Buscando todas as lojas completas...");
    
    const ss = SpreadsheetApp.openById(ID_PLANILHA_PROSPECCOES);
    const aba = ss.getSheetByName(ABA_PRINCIPAL);
    
    if (!aba) return [];
    
    const ultimaLinha = aba.getLastRow();
    if (ultimaLinha < 4) return [];
    
    const dados = aba.getRange(4, 1, ultimaLinha - 3, 21).getValues();
    const todasLojas = [];

    for (let i = 0; i < dados.length; i++) {
      const linha = dados[i];
      const nomeLoja = linha[2];
      
      if (nomeLoja && nomeLoja.toString().trim() !== '') {
        const dataUltimoEvento = linha[18];
        const dataRetornoCliente = linha[15];
        const status = linha[16] || 'Em andamento';
        
        const calculoDefasagem = calcularDefasagemComRegra(dataUltimoEvento, dataRetornoCliente, status);
        const defasagemFormatada = formatarDefasagem(calculoDefasagem.defasagemDias);

        const loja = {
          id: linha[0] || '',
          loja: nomeLoja.toString().trim(),
          segmento: linha[3] || '',
          telefone: linha[4] || '',
          fornecedor: linha[5] || '',
          trafego: linha[6] || '',
          quantidade_lojas: linha[7] || '',
          adesao: linha[8] || 0,
          usuario: linha[13] || '',
          representante: linha[14] || '',
          data_retorno_cliente: linha[15] ? formatarData(linha[15]) : '',
          status: status,
          evento: linha[17] || '',
          data_ultimo_evento: linha[18] ? formatarData(linha[18]) : '',
          defasagem: defasagemFormatada,
          tipo_calculo: calculoDefasagem.tipo,
          observacao: linha[20] || ''
        };
        
        todasLojas.push(loja);
      }
    }

    console.log("✅ Todas as lojas encontradas:", todasLojas.length);
    return todasLojas;

  } catch (error) {
    console.log("❌ Erro em buscarTodasLojasCompletas:", error);
    return [];
  }
}



