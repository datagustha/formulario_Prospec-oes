    const lojasArray = Array.from(setLojas).sort((a, b) => a.localeCompare(b, 'pt-BR'));
    console.log("Lojas carregadas:", lojasArray.length);
    return lojasArray;

  } catch (error) {
    console.log("Erro buscarTodasLojas:", error);
    return [];
  }
}

function formatarDefasagem(dias) {
  if (dias === 0) return "0 dias";
  if (dias === 1) return "1 dia";
  if (dias > 1) return `${dias} dias`;
  return "";
}
function calcularDefasagemComRegra(dataUltimoEvento, dataRetornoCliente, status) {
  const hoje = new Date();
  hoje.setHours(0, 0, 0, 0);
  
  // 🔥 SE FOR CADASTRO NOVO (dataUltimoEvento é hoje), defasagem = 0
  if (dataUltimoEvento && dataUltimoEvento instanceof Date && !isNaN(dataUltimoEvento.getTime())) {
    const dataEvento = new Date(dataUltimoEvento);
    dataEvento.setHours(0, 0, 0, 0);
    
    // Se o evento foi hoje, defasagem = 0
    if (dataEvento.getTime() === hoje.getTime()) {
      return { defasagemDias: 0, tipo: 'hoje' };
    }
  }
  
  // ⭐⭐ VERIFICA SE STATUS É "CONCLUÍDO" OU "NÃO CONCLUÍDO"
  if (status === "CONCLUÍDO" || status === "NÃO CONCLUÍDO") {
    return { defasagemDias: 0, tipo: 'encerrado' };
  }
  
  if (dataRetornoCliente && dataRetornoCliente instanceof Date && !isNaN(dataRetornoCliente.getTime())) {
    const dataRetorno = new Date(dataRetornoCliente);
    dataRetorno.setHours(0, 0, 0, 0);
    
    const diffMs = hoje - dataRetorno;
    const dias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    return { defasagemDias: dias, tipo: 'data_retorno' };
  }
  
  if (dataUltimoEvento && dataUltimoEvento instanceof Date && !isNaN(dataUltimoEvento.getTime())) {
    const dataEvento = new Date(dataUltimoEvento);
    dataEvento.setHours(0, 0, 0, 0);
    
    const diffMs = hoje - dataEvento;
    const dias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    return { defasagemDias: dias, tipo: 'ultimo_evento' };
  }
  
  return { defasagemDias: 0, tipo: 'sem_data' }; // 🔥 MUDANÇA: 0 em vez de 999
}


